   ═══════════════════════════════════════════════════════════════════════ */

class BundleBuilder extends HTMLElement {

  /* ── Private fields ──────────────────────────────────────────────── */
  #selections   = new Map();   // variantId → { productId, title, price, qty, img, panelIndex, isRequired, handle }
  #tiers        = [];          // [{ qty, discount, label, color }]
  #freeGift     = null;        // { id, title, image, threshold } | null
  #freeGiftAdded = false;
  #minQty       = 1;
  #maxQty       = 6;
  #bundleType   = 'mix_match';
  #dir          = 'ltr';
  #locale       = 'en';
  #currency     = 'KWD';
  #wizardStep   = 1;
  #wizardTotal  = 1;
  #wizardAnim   = 'slide';
  #filterTags   = [];
  #filterVendors = [];
