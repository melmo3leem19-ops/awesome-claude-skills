{%- liquid
  assign bb = section.settings
  assign bundle_type = bb.bundle_type | default: 'mix_match'
  assign is_wizard = false
  if bundle_type == 'wizard'
    assign is_wizard = true
  endif
  assign is_tiered = false
  if bundle_type == 'tiered'
    assign is_tiered = true
  endif
  assign locale_dir = 'ltr'
  assign locale_is_ar = false
  if request.locale.iso_code == 'ar'
    assign locale_dir = 'rtl'
    assign locale_is_ar = true
  endif
  assign min_qty = bb.min_products | default: 1
  assign max_qty = bb.max_products | default: 6
  assign section_id = section.id
-%}

{%- comment -%} ── Metaobject config override ──────────────────────────────── {%- endcomment -%}
{%- if bb.metaobject_id != blank -%}
  {%- assign mo = shop.metaobjects[bb.metaobject_id] -%}
  {%- if mo != nil -%}
    {%- assign bundle_type   = mo.bundle_type.value   | default: bundle_type -%}
    {%- assign min_qty       = mo.min_products.value  | default: min_qty -%}
    {%- assign max_qty       = mo.max_products.value  | default: max_qty -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%} ── Tiers JSON for JS ────────────────────────────────────────── {%- endcomment -%}
{%- capture tiers_json -%}
[
  {%- if bb.tier_1_qty > 0 -%}{"qty":{{ bb.tier_1_qty }},"discount":{{ bb.tier_1_discount }},"label":{{ bb.tier_1_label | default: '' | json }},"color":{{ bb.color_tier_1 | default: '#2ecc71' | json }}}{%- endif -%}
  {%- if bb.tier_2_qty > 0 -%},{"qty":{{ bb.tier_2_qty }},"discount":{{ bb.tier_2_discount }},"label":{{ bb.tier_2_label | default: '' | json }},"color":{{ bb.color_tier_2 | default: '#3498db' | json }}}{%- endif -%}
  {%- if bb.tier_3_qty > 0 -%},{"qty":{{ bb.tier_3_qty }},"discount":{{ bb.tier_3_discount }},"label":{{ bb.tier_3_label | default: '' | json }},"color":"#9b59b6"}{%- endif -%}
  {%- if bb.tier_4_qty > 0 -%},{"qty":{{ bb.tier_4_qty }},"discount":{{ bb.tier_4_discount }},"label":{{ bb.tier_4_label | default: '' | json }},"color":"#e67e22"}{%- endif -%}
  {%- if bb.tier_5_qty > 0 -%},{"qty":{{ bb.tier_5_qty }},"discount":{{ bb.tier_5_discount }},"label":{{ bb.tier_5_label | default: '' | json }},"color":"#e74c3c"}{%- endif -%}
]
{%- endcapture -%}

{%- comment -%} ── Free gift product JSON ───────────────────────────────────── {%- endcomment -%}
{%- if bb.enable_free_gift and bb.free_gift_product != blank -%}
  {%- assign fg_product = bb.free_gift_product -%}
  {%- capture free_gift_json -%}{"id":{{ fg_product.variants.first.id }},"title":{{ fg_product.title | json }},"image":{{ fg_product.featured_image | image_url: width: 200 | json }},"threshold":{{ bb.free_gift_threshold | default: 5 }}}{%- endcapture -%}
{%- else -%}
  {%- assign free_gift_json = 'null' -%}
{%- endif -%}

{%- comment -%} ── Timer end date ───────────────────────────────────────────── {%- endcomment -%}
{%- assign timer_end = bb.timer_end_date | default: '' -%}

<section
  id="bundle-builder-{{ section_id }}"
  class="bundle-builder-section"
  data-section-id="{{ section_id }}"
  dir="{{ locale_dir }}"
  aria-label="{%- if locale_is_ar -%}أداة بناء الطقم{%- else -%}Bundle Builder{%- endif -%}"
>

  {%- comment -%} ── Countdown Timer ──────────────────────────────────────── {%- endcomment -%}
  {%- if bb.show_timer and timer_end != blank -%}
  <div class="bb-timer-bar" role="timer" aria-live="polite" data-end="{{ timer_end }}">
    <span class="bb-timer-label">{%- if locale_is_ar -%}ينتهي العرض خلال{%- else -%}Offer ends in{%- endif -%}</span>
    <span class="bb-timer-display">
      <span class="bb-timer-unit" data-unit="days">00</span><span class="bb-timer-sep">d</span>
      <span class="bb-timer-unit" data-unit="hours">00</span><span class="bb-timer-sep">h</span>
      <span class="bb-timer-unit" data-unit="minutes">00</span><span class="bb-timer-sep">m</span>
      <span class="bb-timer-unit" data-unit="seconds">00</span><span class="bb-timer-sep">s</span>
    </span>
  </div>
  {%- endif -%}

  <bundle-builder
    data-section-id="{{ section_id }}"
    data-bundle-type="{{ bundle_type }}"
    data-min="{{ min_qty }}"
    data-max="{{ max_qty }}"
    data-currency="{{ shop.currency }}"
    data-locale="{{ request.locale.iso_code }}"
    data-dir="{{ locale_dir }}"
    data-tiers="{{ tiers_json | escape }}"
    data-free-gift="{{ free_gift_json | escape }}"
    data-filter-tags="{{ bb.filter_by_tag | default: '' | escape }}"
    data-filter-vendors="{{ bb.filter_by_vendor | default: '' | escape }}"
    data-wizard-animation="{{ bb.wizard_step_animation | default: 'slide' }}"
    data-metaobject-id="{{ bb.metaobject_id | default: '' }}"
    class="bundle-builder bundle-builder--{{ bundle_type }}{% if is_wizard %} bundle-builder--wizard{% endif %}"
    role="main"
  >

    {%- comment -%} ── Section header ───────────────────────────────────────── {%- endcomment -%}
    <header class="bb-header">
      <div class="bb-header__inner">
        {%- if bb.show_bundle_type_badge -%}
          <span class="bb-type-badge bb-type-badge--{{ bundle_type }}">
            {{ bb.bundle_type_badge_label | default: bundle_type | replace: '_', ' ' | capitalize }}
          </span>
        {%- endif -%}
        {%- if bb.heading != blank -%}
          <h2 class="bb-heading">{{ bb.heading }}</h2>
        {%- endif -%}
        {%- if bb.subheading != blank -%}
          <p class="bb-subheading">{{ bb.subheading }}</p>
        {%- endif -%}
      </div>
    </header>

    {%- comment -%} ── Tiered discount bar ──────────────────────────────────── {%- endcomment -%}
    {%- if is_tiered or bb.tier_1_qty > 0 -%}
    <div class="bb-tier-bar" role="group" aria-label="{%- if locale_is_ar -%}مستويات الخصم{%- else -%}Discount tiers{%- endif -%}">
      {%- if bb.tier_1_qty > 0 -%}
      <div class="bb-tier-badge" data-qty="{{ bb.tier_1_qty }}" data-discount="{{ bb.tier_1_discount }}" style="--tier-color:{{ bb.color_tier_1 | default: '#2ecc71' }}">
        <span class="bb-tier-badge__qty">{{ bb.tier_1_qty }}+</span>
        <span class="bb-tier-badge__pct">{{ bb.tier_1_discount }}%</span>
        <span class="bb-tier-badge__label">{{ bb.tier_1_label | default: 'off' }}</span>
      </div>
      {%- endif -%}
      {%- if bb.tier_2_qty > 0 -%}
      <div class="bb-tier-badge" data-qty="{{ bb.tier_2_qty }}" data-discount="{{ bb.tier_2_discount }}" style="--tier-color:{{ bb.color_tier_2 | default: '#3498db' }}">
        <span class="bb-tier-badge__qty">{{ bb.tier_2_qty }}+</span>
        <span class="bb-tier-badge__pct">{{ bb.tier_2_discount }}%</span>
        <span class="bb-tier-badge__label">{{ bb.tier_3_label | default: 'off' }}</span>
      </div>
      {%- endif -%}
      {%- if bb.tier_3_qty > 0 -%}
      <div class="bb-tier-badge" data-qty="{{ bb.tier_3_qty }}" data-discount="{{ bb.tier_3_discount }}" style="--tier-color:#9b59b6">
        <span class="bb-tier-badge__qty">{{ bb.tier_3_qty }}+</span>
        <span class="bb-tier-badge__pct">{{ bb.tier_3_discount }}%</span>
        <span class="bb-tier-badge__label">{{ bb.tier_3_label | default: 'off' }}</span>
      </div>
      {%- endif -%}
      {%- if bb.tier_4_qty > 0 -%}
      <div class="bb-tier-badge" data-qty="{{ bb.tier_4_qty }}" data-discount="{{ bb.tier_4_discount }}" style="--tier-color:#e67e22">
        <span class="bb-tier-badge__qty">{{ bb.tier_4_qty }}+</span>
        <span class="bb-tier-badge__pct">{{ bb.tier_4_discount }}%</span>
        <span class="bb-tier-badge__label">{{ bb.tier_4_label | default: 'off' }}</span>
      </div>
      {%- endif -%}
      {%- if bb.tier_5_qty > 0 -%}
      <div class="bb-tier-badge" data-qty="{{ bb.tier_5_qty }}" data-discount="{{ bb.tier_5_discount }}" style="--tier-color:#e74c3c">
        <span class="bb-tier-badge__qty">{{ bb.tier_5_qty }}+</span>
        <span class="bb-tier-badge__pct">{{ bb.tier_5_discount }}%</span>
        <span class="bb-tier-badge__label">{{ bb.tier_5_label | default: 'off' }}</span>
      </div>
      {%- endif -%}
    </div>
    {%- endif -%}

    {%- comment -%} ── Free gift banner (hidden until threshold reached) ────── {%- endcomment -%}
    {%- if bb.enable_free_gift and bb.free_gift_product != blank -%}
    <div class="bb-free-gift-banner" hidden aria-live="polite">
      <div class="bb-free-gift-banner__inner">
        <span class="bb-free-gift-banner__icon" aria-hidden="true">🎁</span>
        <span class="bb-free-gift-banner__text">
          {%- if locale_is_ar -%}لقد حصلت على هدية مجانية!{%- else -%}You've unlocked a free gift!{%- endif -%}
        </span>
        <div class="bb-free-gift-product">
          {%- assign fg = bb.free_gift_product -%}
          <img
            src="{{ fg.featured_image | image_url: width: 60 }}"
            alt="{{ fg.title | escape }}"
            width="60" height="60"
            loading="lazy"
          >
          <span>{{ fg.title }}</span>
        </div>
      </div>
    </div>
    {%- endif -%}

    {%- comment -%} ── Wizard step indicator ────────────────────────────────── {%- endcomment -%}
    {%- if is_wizard -%}
    <nav class="bb-wizard-nav" aria-label="{%- if locale_is_ar -%}خطوات الطقم{%- else -%}Bundle steps{%- endif -%}">
      <div class="bb-wizard-steps" id="bb-wizard-steps-{{ section_id }}">
        {%- assign step_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection' -%}
            {%- assign step_index = step_index | plus: 1 -%}
            <button
              class="bb-wizard-step-btn{% if step_index == 1 %} is-active{% endif %}"
              data-step="{{ step_index }}"
              aria-selected="{% if step_index == 1 %}true{% else %}false{% endif %}"
              aria-controls="bb-step-panel-{{ step_index }}-{{ section_id }}"
              type="button"
            >
              <span class="bb-wizard-step-btn__number" aria-hidden="true">{{ step_index }}</span>
              <span class="bb-wizard-step-btn__label">
                {{ block.settings.collection_tab_label | default: block.settings.collection.title | default: 'Step' }}
              </span>
              <span class="bb-wizard-step-btn__check" aria-hidden="true">✓</span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="bb-wizard-progress-text" aria-live="polite">
        <span class="bb-wizard-step-current">1</span>
        {%- if locale_is_ar -%}من{%- else -%}of{%- endif -%}
        <span class="bb-wizard-step-total">{{ step_index }}</span>
      </div>
    </nav>
    {%- endif -%}

    {%- comment -%} ── Main layout: picker + sidebar ────────────────────────── {%- endcomment -%}
    <div class="bb-layout">

      {%- comment -%} ── Product picker panel ─────────────────────────────── {%- endcomment -%}
      <div class="bb-picker">

        {%- comment -%} ── Search bar ───────────────────────────────────────── {%- endcomment -%}
        {%- if bb.enable_search -%}
        <div class="bb-search-bar">
          <label for="bb-search-{{ section_id }}" class="visually-hidden">
            {%- if locale_is_ar -%}ابحث عن المنتجات{%- else -%}Search products{%- endif -%}
          </label>
          <input
            type="search"
            id="bb-search-{{ section_id }}"
            class="bb-search-input"
            placeholder="{%- if locale_is_ar -%}ابحث عن المنتجات…{%- else -%}Search products…{%- endif -%}"
            autocomplete="off"
            aria-controls="bb-product-grid-{{ section_id }}"
          >
          <span class="bb-search-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          </span>
        </div>
        {%- endif -%}

        {%- comment -%} ── Collection tabs (non-wizard) / Step panels (wizard) ─ {%- endcomment -%}
        {%- assign has_collections = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection' -%}
            {%- assign has_collections = true -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if has_collections -%}
          {%- unless is_wizard -%}
          <div class="bb-tabs" role="tablist" aria-label="{%- if locale_is_ar -%}أقسام المنتجات{%- else -%}Product collections{%- endif -%}">
            {%- assign tab_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'collection' -%}
                {%- assign tab_index = tab_index | plus: 1 -%}
                <button
                  class="bb-tab{% if tab_index == 1 %} is-active{% endif %}"
                  role="tab"
                  data-tab="{{ tab_index }}"
                  aria-selected="{% if tab_index == 1 %}true{% else %}false{% endif %}"
                  aria-controls="bb-panel-{{ tab_index }}-{{ section_id }}"
                  id="bb-tab-{{ tab_index }}-{{ section_id }}"
                  type="button"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.tab_icon != blank -%}
                    <span class="bb-tab__icon" aria-hidden="true">{{ block.settings.tab_icon }}</span>
                  {%- endif -%}
                  {{ block.settings.collection_tab_label | default: block.settings.collection.title | default: 'Collection' }}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- endunless -%}

          <div class="bb-collections-wrapper" id="bb-product-grid-{{ section_id }}">
            {%- assign panel_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'collection' -%}
                {%- assign panel_index = panel_index | plus: 1 -%}
                {%- assign blk = block.settings -%}
                {%- assign col = blk.collection -%}
                {%- assign p_limit = blk.product_limit | default: 50 -%}
                {%- assign allow_tags   = blk.allow_tag_filter | default: bb.filter_by_tag -%}
                {%- assign allow_vendors = blk.allow_vendor_filter | default: bb.filter_by_vendor -%}

                {%- comment -%} Build required product ID list for this block {%- endcomment -%}
                {%- assign req_ids = '' -%}
                {%- for block2 in section.blocks -%}
                  {%- if block2.type == 'required_product' and block2.settings.step_ref == panel_index -%}
                    {%- assign req_ids = req_ids | append: block2.settings.product.id | append: ',' -%}
                  {%- endif -%}
                {%- endfor -%}

                <div
                  class="bb-panel{% if is_wizard %} bb-step-panel{% endif %}{% if panel_index == 1 %} is-active{% endif %}"
                  id="{% if is_wizard %}bb-step-panel-{{ panel_index }}-{{ section_id }}{% else %}bb-panel-{{ panel_index }}-{{ section_id }}{% endif %}"
                  role="{% if is_wizard %}region{% else %}tabpanel{% endif %}"
                  aria-labelledby="{% unless is_wizard %}bb-tab-{{ panel_index }}-{{ section_id }}{% endunless %}"
                  data-panel="{{ panel_index }}"
                  data-step-min="{{ blk.step_min_qty | default: 1 }}"
                  data-step-max="{{ blk.step_max_qty | default: max_qty }}"
                  data-required-ids="{{ req_ids | remove_last: ',' }}"
                  data-allow-tags="{{ allow_tags | escape }}"
                  data-allow-vendors="{{ allow_vendors | escape }}"
                  {{ block.shopify_attributes }}
                >
                  {%- if is_wizard -%}
                  <div class="bb-step-header">
                    <h3 class="bb-step-title">
                      {{ blk.collection_tab_label | default: col.title | default: 'Step' }}
                    </h3>
                    {%- if blk.step_description != blank -%}
                      <p class="bb-step-description">{{ blk.step_description }}</p>
                    {%- endif -%}
                  </div>
                  {%- endif -%}

                  {%- if blk.show_collection_image and col.image -%}
                  <div class="bb-collection-hero">
                    <img
                      src="{{ col.image | image_url: width: 900 }}"
                      alt="{{ col.title | escape }}"
                      loading="lazy"
                      width="900"
                      height="300"
                      class="bb-collection-hero__img"
                    >
                  </div>
                  {%- endif -%}

                  <div
                    class="bb-product-grid"
                    style="--bb-cols-desktop:{{ blk.desktop_columns | default: bb.desktop_columns | default: 3 }};--bb-cols-mobile:{{ blk.mobile_columns | default: bb.mobile_columns | default: 2 }}"
                  >
                    {%- assign products_shown = 0 -%}
                    {%- for product in col.products limit: p_limit -%}

                      {%- comment -%} Tag / vendor filter ─────────────────────── {%- endcomment -%}
                      {%- assign tag_ok = true -%}
                      {%- if allow_tags != blank -%}
                        {%- assign filter_tags = allow_tags | split: ',' -%}
                        {%- assign tag_ok = false -%}
                        {%- for ft in filter_tags -%}
                          {%- assign ft_clean = ft | strip -%}
                          {%- if product.tags contains ft_clean -%}
                            {%- assign tag_ok = true -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}

                      {%- assign vendor_ok = true -%}
                      {%- if allow_vendors != blank -%}
                        {%- assign filter_vendors = allow_vendors | split: ',' -%}
                        {%- assign vendor_ok = false -%}
                        {%- for fv in filter_vendors -%}
                          {%- assign fv_clean = fv | strip -%}
                          {%- if product.vendor == fv_clean -%}
                            {%- assign vendor_ok = true -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}

                      {%- unless tag_ok and vendor_ok -%}{%- continue -%}{%- endunless -%}

                      {%- assign is_required = false -%}
                      {%- if req_ids contains product.id -%}
                        {%- assign is_required = true -%}
                      {%- endif -%}

                      {%- assign first_variant = product.variants.first -%}
                      {%- assign has_multiple_variants = false -%}
                      {%- if product.variants.size > 1 -%}
                        {%- assign has_multiple_variants = true -%}
                      {%- endif -%}

                      <div
                        class="bb-product-card{% if is_required %} is-required{% endif %}"
                        data-product-id="{{ product.id }}"
                        data-variant-id="{{ first_variant.id }}"
                        data-title="{{ product.title | escape }}"
                        data-price="{{ first_variant.price }}"
                        data-handle="{{ product.handle }}"
                        data-available="{{ first_variant.available }}"
                        data-required="{{ is_required }}"
                        data-has-variants="{{ has_multiple_variants }}"
                        data-panel="{{ panel_index }}"
                        tabindex="0"
                        role="article"
                        aria-label="{{ product.title | escape }}"
                      >
                        <div class="bb-product-card__image-wrap">
                          {%- if product.featured_image -%}
                            <img
                              src="{{ product.featured_image | image_url: width: 400 }}"
                              alt="{{ product.featured_image.alt | default: product.title | escape }}"
                              loading="lazy"
                              width="400"
                              height="400"
                              class="bb-product-card__img"
                            >
                          {%- else -%}
                            <div class="bb-product-card__no-image" aria-hidden="true">
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="m9 9 6 6m0-6-6 6"/></svg>
                            </div>
                          {%- endif -%}

                          {%- unless first_variant.available -%}
                            <div class="bb-product-card__sold-out" aria-label="{%- if locale_is_ar -%}نفدت الكمية{%- else -%}Sold out{%- endif -%}">
                              {%- if locale_is_ar -%}نفدت الكمية{%- else -%}Sold out{%- endif -%}
                            </div>
                          {%- endunless -%}

                          {%- if is_required -%}
                            <div class="bb-product-card__required-badge">
                              {%- if locale_is_ar -%}إلزامي{%- else -%}Required{%- endif -%}
                            </div>
                          {%- endif -%}

                          <button
                            class="bb-product-card__quick-view"
                            data-product-handle="{{ product.handle }}"
                            data-product-url="{{ product.url }}"
                            aria-label="{%- if locale_is_ar -%}عرض سريع{%- else -%}Quick view{%- endif -%} {{ product.title | escape }}"
                            type="button"
                          >
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                          </button>
                        </div>

                        <div class="bb-product-card__info">
                          <p class="bb-product-card__vendor">{{ product.vendor }}</p>
                          <h3 class="bb-product-card__title">{{ product.title }}</h3>

                          <div class="bb-product-card__price-row">
                            <span class="bb-product-card__price" data-price="{{ first_variant.price }}">
                              {{ first_variant.price | money }}
                            </span>
                            {%- if first_variant.compare_at_price > first_variant.price -%}
                              <s class="bb-product-card__compare-price">{{ first_variant.compare_at_price | money }}</s>
                            {%- endif -%}
                          </div>

                          {%- if has_multiple_variants -%}
                          <div class="bb-product-card__variant-select-wrap">
                            <select
                              class="bb-product-card__variant-select"
                              aria-label="{%- if locale_is_ar -%}اختر الخيار{%- else -%}Select variant{%- endif -%}"
                              data-product-id="{{ product.id }}"
                            >
                              {%- for variant in product.variants -%}
                                <option
                                  value="{{ variant.id }}"
                                  data-price="{{ variant.price }}"
                                  data-available="{{ variant.available }}"
                                  {% unless variant.available %}disabled{% endunless %}
                                >
                                  {{ variant.title }} — {{ variant.price | money }}
                                </option>
                              {%- endfor -%}
                            </select>
                          </div>
                          {%- endif -%}

                          <div class="bb-product-card__actions">
                            <button
                              class="bb-product-card__add-btn"
                              data-action="add"
                              data-product-id="{{ product.id }}"
                              data-variant-id="{{ first_variant.id }}"
                              aria-label="{%- if locale_is_ar -%}أضف إلى الطقم{%- else -%}Add to bundle{%- endif -%}: {{ product.title | escape }}"
                              type="button"
                              {% unless first_variant.available %}disabled aria-disabled="true"{% endunless %}
                            >
                              <span class="bb-btn-icon" aria-hidden="true">+</span>
                              <span class="bb-btn-label">{%- if locale_is_ar -%}أضف{%- else -%}Add{%- endif -%}</span>
                            </button>
                            <button
                              class="bb-product-card__qty-btn bb-product-card__qty-btn--minus"
                              data-action="remove"
                              data-product-id="{{ product.id }}"
                              data-variant-id="{{ first_variant.id }}"
                              aria-label="{%- if locale_is_ar -%}إزالة من الطقم{%- else -%}Remove from bundle{%- endif -%}: {{ product.title | escape }}"
                              type="button"
                              hidden
                            >−</button>
                            <span
                              class="bb-product-card__qty-display"
                              aria-live="polite"
                              aria-label="{%- if locale_is_ar -%}الكمية في الطقم{%- else -%}Quantity in bundle{%- endif -%}"
                              hidden
                            >0</span>
                          </div>
                        </div>
                      </div>

                      {%- assign products_shown = products_shown | plus: 1 -%}
                    {%- endfor -%}

                    {%- if products_shown == 0 -%}
                      <p class="bb-empty-collection">{%- if locale_is_ar -%}لا توجد منتجات مطابقة لاختياراتك.{%- else -%}No products match your filters.{%- endif -%}</p>
                    {%- endif -%}
                  </div><!-- /.bb-product-grid -->
                </div><!-- /.bb-panel -->
              {%- endif -%}
            {%- endfor -%}
          </div><!-- /.bb-collections-wrapper -->
        {%- endif -%}

        {%- comment -%} ── Wizard navigation buttons ─────────────────────────── {%- endcomment -%}
        {%- if is_wizard -%}
        <div class="bb-wizard-controls" aria-label="{%- if locale_is_ar -%}التنقل بين الخطوات{%- else -%}Step navigation{%- endif -%}">
          <button class="bb-wizard-btn bb-wizard-btn--prev" id="bb-prev-{{ section_id }}" type="button" hidden>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
            {%- if locale_is_ar -%}السابق{%- else -%}Previous{%- endif -%}
          </button>
          <button class="bb-wizard-btn bb-wizard-btn--next" id="bb-next-{{ section_id }}" type="button">
            {%- if locale_is_ar -%}التالي{%- else -%}Next{%- endif -%}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
        {%- endif -%}

      </div><!-- /.bb-picker -->

      {%- comment -%} ── Sidebar summary ───────────────────────────────────── {%- endcomment -%}
      <aside class="bb-sidebar" aria-label="{%- if locale_is_ar -%}ملخص الطقم{%- else -%}Bundle summary{%- endif -%}">

        {%- comment -%} ── Progress bar ─────────────────────────────────────── {%- endcomment -%}
        {%- if bb.show_progress_bar -%}
        <div class="bb-progress-wrap" aria-label="{%- if locale_is_ar -%}تقدّم الطقم{%- else -%}Bundle progress{%- endif -%}">
          <div class="bb-progress-text" aria-live="polite">
            <span class="bb-progress-current">0</span>
            {%- if locale_is_ar -%}من{%- else -%}of{%- endif -%}
            <span class="bb-progress-max">{{ max_qty }}</span>
            {%- if locale_is_ar -%}منتجات مختارة{%- else -%}items selected{%- endif -%}
          </div>
          <div
            class="bb-progress-bar"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax="{{ max_qty }}"
            aria-valuenow="0"
            aria-label="{%- if locale_is_ar -%}تقدّم الطقم{%- else -%}Bundle progress{%- endif -%}"
          >
            <div class="bb-progress-fill" style="width:0%"></div>
          </div>
          <p class="bb-progress-hint" aria-live="polite">
            {%- if locale_is_ar -%}أضف{%- else -%}Add{%- endif -%}
            <strong class="bb-progress-remaining">{{ max_qty }}</strong>
            {%- if locale_is_ar -%}منتجات إضافية لإكمال طقمك{%- else -%}more items to complete your bundle{%- endif -%}
          </p>
        </div>
        {%- endif -%}

        {%- comment -%} ── Active discount display ───────────────────────────── {%- endcomment -%}
        <div class="bb-active-discount" aria-live="polite" hidden>
          <span class="bb-active-discount__icon" aria-hidden="true">🏷</span>
          <span class="bb-active-discount__text"></span>
        </div>
        <div class="bb-next-tier-hint" aria-live="polite" hidden>
          <span class="bb-next-tier-hint__text"></span>
        </div>

        {%- comment -%} ── Selected items list ───────────────────────────────── {%- endcomment -%}
        <div class="bb-selection-summary">
          <h3 class="bb-selection-summary__heading">
            {%- if locale_is_ar -%}طقمك{%- else -%}Your Bundle{%- endif -%}
          </h3>
          <ul
            class="bb-selection-list"
            id="bb-selection-list-{{ section_id }}"
            aria-label="{%- if locale_is_ar -%}المنتجات المختارة{%- else -%}Selected products{%- endif -%}"
            aria-live="polite"
          >
            <li class="bb-selection-empty">
              {%- if locale_is_ar -%}طقمك فارغ. ابدأ بإضافة المنتجات!{%- else -%}Your bundle is empty. Start adding products!{%- endif -%}
            </li>
          </ul>
        </div>

        {%- comment -%} ── Price summary ─────────────────────────────────────── {%- endcomment -%}
        <div class="bb-price-summary">
          {%- if bb.show_savings -%}
          <div class="bb-price-row bb-price-row--original" hidden>
            <span>{%- if locale_is_ar -%}السعر الأصلي{%- else -%}Original{%- endif -%}</span>
            <span class="bb-original-total">{{ 0 | money }}</span>
          </div>
          <div class="bb-price-row bb-price-row--savings" hidden>
            <span>{%- if locale_is_ar -%}وفّرت{%- else -%}You save{%- endif -%}</span>
            <span class="bb-savings-amount"></span>
          </div>
          {%- endif -%}
          <div class="bb-price-row bb-price-row--total">
            <span>{%- if locale_is_ar -%}الإجمالي{%- else -%}Total{%- endif -%}</span>
            <strong class="bb-bundle-total" aria-live="polite">{{ 0 | money }}</strong>
          </div>
        </div>

        {%- comment -%} ── CTA button ────────────────────────────────────────── {%- endcomment -%}
        <button
          class="bb-cta-btn"
          id="bb-cta-{{ section_id }}"
          type="button"
          disabled
          aria-disabled="true"
          aria-label="{%- if locale_is_ar -%}أضف الطقم إلى السلة{%- else -%}Add bundle to cart{%- endif -%}"
        >
          <span class="bb-cta-btn__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          </span>
          <span class="bb-cta-btn__label">{%- if locale_is_ar -%}أضف الطقم إلى السلة{%- else -%}Add Bundle to Cart{%- endif -%}</span>
          <span class="bb-cta-btn__spinner" aria-hidden="true" hidden></span>
        </button>

        <p class="bb-cta-hint" aria-live="assertive"></p>

        {%- if bb.show_savings -%}
        <p class="bb-guarantee-text">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          {%- if locale_is_ar -%}دفع آمن · إرجاع مجاني{%- else -%}Secure checkout · Free returns{%- endif -%}
        </p>
        {%- endif -%}

      </aside><!-- /.bb-sidebar -->
    </div><!-- /.bb-layout -->

    {%- comment -%} ── Mobile drawer ─────────────────────────────────────────── {%- endcomment -%}
    <div class="bb-mobile-drawer" id="bb-drawer-{{ section_id }}" aria-hidden="true">
      <div class="bb-mobile-drawer__handle" aria-label="{%- if locale_is_ar -%}فتح ملخص الطقم{%- else -%}Open bundle summary{%- endif -%}" tabindex="0" role="button">
        <span class="bb-mobile-drawer__pill"></span>
        <span class="bb-mobile-drawer__preview">
          <span class="bb-drawer-qty">0</span> {%- if locale_is_ar -%}منتجات{%- else -%}items{%- endif -%} ·
          <strong class="bb-drawer-total">{{ 0 | money }}</strong>
        </span>
        <span class="bb-mobile-drawer__arrow" aria-hidden="true">▲</span>
      </div>
      <div class="bb-mobile-drawer__body">
        <div class="bb-mobile-drawer__inner">
          <!-- cloned at runtime -->
        </div>
        <button class="bb-cta-btn bb-cta-btn--drawer" type="button" disabled aria-disabled="true">
          {%- if locale_is_ar -%}أضف الطقم إلى السلة{%- else -%}Add Bundle to Cart{%- endif -%}
        </button>
      </div>
    </div>

    {%- comment -%} ── Quick view dialog ─────────────────────────────────────── {%- endcomment -%}
    <dialog
      class="bb-quick-view-dialog"
      id="bb-quick-view-{{ section_id }}"
      aria-label="{%- if locale_is_ar -%}عرض سريع للمنتج{%- else -%}Product quick view{%- endif -%}"
      aria-modal="true"
    >
      <button class="bb-quick-view-close" type="button" aria-label="{%- if locale_is_ar -%}إغلاق{%- else -%}Close{%- endif -%}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <div class="bb-quick-view-content" aria-live="polite">
        <div class="bb-quick-view-loading">
          <div class="bb-spinner" aria-label="{%- if locale_is_ar -%}جارٍ التحميل…{%- else -%}Loading…{%- endif -%}"></div>
        </div>
      </div>
    </dialog>

    {%- comment -%} ── Screen-reader status ──────────────────────────────────── {%- endcomment -%}
    <div class="visually-hidden" aria-live="assertive" id="bb-sr-status-{{ section_id }}"></div>

  </bundle-builder>
</section>

<style>
/* ═══════════════════════════════════════════════════════════════════════════
   BUNDLE BUILDER — Al Moallem Mill
   All measurements use CSS logical properties for RTL/LTR parity.
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── CSS custom properties ─────────────────────────────────────────────── */
bundle-builder {
  --bb-color-primary:       {{ section.settings.color_primary       | default: '#1a1a2e' }};
  --bb-color-accent:        {{ section.settings.color_accent        | default: '#c8a96e' }};
  --bb-color-bg:            {{ section.settings.color_bg            | default: '#f9f7f4' }};
  --bb-color-card-bg:       {{ section.settings.color_card_bg       | default: '#ffffff' }};
  --bb-color-card-border:   {{ section.settings.color_card_border   | default: '#e8e3dc' }};
  --bb-color-card-hover:    {{ section.settings.color_card_hover_border | default: '#c8a96e' }};
  --bb-color-text:          {{ section.settings.color_text          | default: '#1a1a2e' }};
  --bb-color-text-muted:    {{ section.settings.color_text_muted    | default: '#6b6b7b' }};
  --bb-color-progress-bg:   {{ section.settings.color_progress_bg   | default: '#e8e3dc' }};
  --bb-color-progress-fill: {{ section.settings.color_accent        | default: '#c8a96e' }};
  --bb-color-tier-1:        {{ section.settings.color_tier_1        | default: '#2ecc71' }};
  --bb-color-tier-2:        {{ section.settings.color_tier_2        | default: '#3498db' }};
  --bb-color-free-gift:     {{ section.settings.color_free_gift     | default: '#e74c3c' }};
  --bb-color-required:      #e74c3c;
  --bb-color-success:       #27ae60;
  --bb-color-disabled:      #b0b0b0;
  --bb-radius-card:         {{ section.settings.card_border_radius  | default: 12 }}px;
  --bb-radius-btn:          {{ section.settings.button_border_radius| default: 8 }}px;
  --bb-font-size-base:      1rem;
  --bb-font-size-sm:        0.875rem;
  --bb-font-size-xs:        0.75rem;
  --bb-transition:          0.25s ease;
  --bb-shadow-card:         0 2px 12px rgba(0,0,0,.07);
  --bb-shadow-card-hover:   0 6px 24px rgba(0,0,0,.12);
  --bb-sidebar-width:       320px;
  --bb-cols-desktop:        3;
  --bb-cols-mobile:         2;
}

/* ── Utility ───────────────────────────────────────────────────────────── */
.visually-hidden {
  position: absolute;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  border: 0;
}

/* ── Section wrapper ───────────────────────────────────────────────────── */
.bundle-builder-section {
  background: var(--bb-color-bg);
  color: var(--bb-color-text);
  font-size: var(--bb-font-size-base);
  padding-block: 3rem;
  container-type: inline-size;
}

bundle-builder {
  display: block;
  max-width: 1400px;
  margin-inline: auto;
  padding-inline: 1.25rem;
}

/* ── Timer bar ─────────────────────────────────────────────────────────── */
.bb-timer-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  background: var(--bb-color-primary);
  color: #fff;
  padding-block: 0.6rem;
  padding-inline: 1rem;
  border-radius: var(--bb-radius-btn);
  margin-block-end: 1.5rem;
  font-size: var(--bb-font-size-sm);
  font-weight: 600;
  letter-spacing: 0.02em;
}

.bb-timer-display {
  display: flex;
  align-items: center;
  gap: 0.2rem;
}

.bb-timer-unit {
  display: inline-block;
  min-width: 2ch;
  text-align: center;
  font-variant-numeric: tabular-nums;
  font-size: 1.1em;
}

.bb-timer-sep {
  opacity: 0.7;
  font-size: 0.85em;
  padding-inline-end: 0.2rem;
}

/* ── Header ────────────────────────────────────────────────────────────── */
.bb-header { margin-block-end: 1.5rem; }
.bb-header__inner { text-align: center; }

.bb-type-badge {
  display: inline-block;
  padding: 0.2rem 0.75rem;
  border-radius: 100px;
  font-size: var(--bb-font-size-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  background: var(--bb-color-accent);
  color: #fff;
  margin-block-end: 0.5rem;
}

.bb-type-badge--tiered  { background: var(--bb-color-tier-1); }
.bb-type-badge--bogo    { background: #9b59b6; }
.bb-type-badge--gift_set { background: var(--bb-color-free-gift); }
.bb-type-badge--wizard  { background: #2c3e50; }

.bb-heading {
  font-size: clamp(1.5rem, 3cqi, 2.5rem);
  font-weight: 800;
  margin: 0 0 0.5rem;
  color: var(--bb-color-primary);
}

.bb-subheading {
  font-size: var(--bb-font-size-base);
  color: var(--bb-color-text-muted);
  margin: 0;
}

/* ── Tier bar ──────────────────────────────────────────────────────────── */
.bb-tier-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  justify-content: center;
  margin-block-end: 1.5rem;
}

.bb-tier-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.1rem;
  border: 2px solid var(--tier-color, var(--bb-color-accent));
  border-radius: var(--bb-radius-card);
  padding: 0.5rem 1rem;
  min-width: 70px;
  background: color-mix(in srgb, var(--tier-color, var(--bb-color-accent)) 10%, transparent);
  transition: background var(--bb-transition), transform var(--bb-transition), box-shadow var(--bb-transition);
  cursor: default;
}

.bb-tier-badge.is-active {
  background: var(--tier-color, var(--bb-color-accent));
  color: #fff;
  transform: scale(1.05);
  box-shadow: 0 4px 16px color-mix(in srgb, var(--tier-color, var(--bb-color-accent)) 40%, transparent);
}

.bb-tier-badge.is-next {
  border-style: dashed;
  animation: tierPulse 1.5s ease-in-out infinite;
}

.bb-tier-badge__qty  { font-size: 1.1rem; font-weight: 800; line-height: 1; }
.bb-tier-badge__pct  { font-size: 1.4rem; font-weight: 900; line-height: 1; color: var(--tier-color, var(--bb-color-accent)); }
.bb-tier-badge.is-active .bb-tier-badge__pct { color: #fff; }
.bb-tier-badge__label { font-size: var(--bb-font-size-xs); text-transform: uppercase; letter-spacing: 0.05em; }

@keyframes tierPulse {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0.6; }
}

/* ── Free gift banner ──────────────────────────────────────────────────── */
.bb-free-gift-banner {
  display: flex;
  background: color-mix(in srgb, var(--bb-color-free-gift) 12%, white);
  border: 2px solid var(--bb-color-free-gift);
  border-radius: var(--bb-radius-card);
  padding: 0.75rem 1rem;
  margin-block-end: 1rem;
  animation: slideDown 0.35s ease;
}

.bb-free-gift-banner__inner {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.bb-free-gift-banner__icon { font-size: 1.5rem; }
.bb-free-gift-banner__text { font-weight: 700; color: var(--bb-color-free-gift); }

.bb-free-gift-product {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: #fff;
  border-radius: calc(var(--bb-radius-card) - 4px);
  padding: 0.25rem 0.5rem;
}

.bb-free-gift-product img {
  border-radius: 4px;
  object-fit: cover;
}

/* ── Wizard nav ────────────────────────────────────────────────────────── */
.bb-wizard-nav {
  margin-block-end: 1.5rem;
}

.bb-wizard-steps {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem;
  counter-reset: wizard-step;
}

.bb-wizard-step-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 1rem;
  border: 2px solid var(--bb-color-card-border);
  border-radius: var(--bb-radius-btn);
  background: var(--bb-color-card-bg);
  font-size: var(--bb-font-size-sm);
  font-weight: 600;
  cursor: pointer;
  transition: border-color var(--bb-transition), background var(--bb-transition), color var(--bb-transition);
  position: relative;
}

.bb-wizard-step-btn.is-active {
  border-color: var(--bb-color-accent);
  background: var(--bb-color-accent);
  color: #fff;
}

.bb-wizard-step-btn.is-complete {
  border-color: var(--bb-color-success);
  background: color-mix(in srgb, var(--bb-color-success) 10%, white);
}

.bb-wizard-step-btn__number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.5rem;
  height: 1.5rem;
  border-radius: 50%;
  border: 2px solid currentColor;
  font-size: var(--bb-font-size-xs);
  font-weight: 800;
}

.bb-wizard-step-btn__check { display: none; }
.bb-wizard-step-btn.is-complete .bb-wizard-step-btn__check { display: inline; }
.bb-wizard-step-btn.is-complete .bb-wizard-step-btn__number { display: none; }

.bb-wizard-progress-text {
  font-size: var(--bb-font-size-sm);
  color: var(--bb-color-text-muted);
  margin-block-start: 0.5rem;
}

/* ── Main layout ───────────────────────────────────────────────────────── */
.bb-layout {
  display: grid;
  grid-template-columns: 1fr var(--bb-sidebar-width);
  gap: 1.5rem;
  align-items: start;
}

@container (max-width: 900px) {
  .bb-layout {
    grid-template-columns: 1fr;
  }
  .bb-sidebar {
    display: none;
  }
}

/* ── Search bar ────────────────────────────────────────────────────────── */
.bb-search-bar {
  position: relative;
  margin-block-end: 1rem;
}

.bb-search-input {
  width: 100%;
  padding-block: 0.6rem;
  padding-inline: 2.5rem 0.75rem;
  border: 1.5px solid var(--bb-color-card-border);
  border-radius: var(--bb-radius-btn);
  font-size: var(--bb-font-size-base);
  background: var(--bb-color-card-bg);
  color: var(--bb-color-text);
  outline-offset: 2px;
  transition: border-color var(--bb-transition);
}

.bb-search-input:focus { border-color: var(--bb-color-accent); }

.bb-search-icon {
  position: absolute;
  inset-block-start: 50%;
  inset-inline-start: 0.65rem;
  transform: translateY(-50%);
  color: var(--bb-color-text-muted);
  pointer-events: none;
  display: flex;
}

/* ── Collection tabs ───────────────────────────────────────────────────── */
.bb-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
  margin-block-end: 1rem;
  border-block-end: 2px solid var(--bb-color-card-border);
  padding-block-end: 0.75rem;
}

.bb-tab {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.45rem 1rem;
  border: 1.5px solid var(--bb-color-card-border);
  border-radius: var(--bb-radius-btn);
  background: transparent;
  font-size: var(--bb-font-size-sm);
  font-weight: 600;
  cursor: pointer;
  transition: all var(--bb-transition);
  color: var(--bb-color-text-muted);
}

.bb-tab:hover,
.bb-tab:focus-visible {
  border-color: var(--bb-color-accent);
  color: var(--bb-color-primary);
}

.bb-tab.is-active {
  background: var(--bb-color-primary);
  border-color: var(--bb-color-primary);
  color: #fff;
}

.bb-tab__icon { font-size: 1.1em; }

/* ── Collections wrapper ───────────────────────────────────────────────── */
.bb-collections-wrapper { position: relative; }

/* ── Panel / step panel ────────────────────────────────────────────────── */
.bb-panel { display: none; }
.bb-panel.is-active { display: block; }

/* ── Wizard step panels ────────────────────────────────────────────────── */
.bundle-builder--wizard .bb-collections-wrapper { overflow: hidden; }

.bb-step-panel {
  display: none;
}

.bb-step-panel.is-active {
  display: block;
}

@media (prefers-reduced-motion: no-preference) {
  /* Forward (LTR) — new panel enters from the right */
  .bb-step-panel.is-active[data-animation="slide"] {
    animation: slideInStep 0.3s ease;
  }
  /* Back (LTR) — new panel enters from the left */
  .bb-step-panel.is-active[data-animation="slide-back"] {
