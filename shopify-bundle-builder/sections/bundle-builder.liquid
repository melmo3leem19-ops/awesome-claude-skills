@media print { .byob-mobilebar, .byob-cta, .byob-card__add { display: none !important; } }
</style>

<script>
(() => {
'use strict';

class BundleBuilder extends HTMLElement {
  #sel = new Map();          // variantId -> {variantId,productId,title,price,qty,img,panel,isGift}
  #tiers = [];
  #freeGift = null;
  #freeGiftAdded = false;
  #min = 3;
  #max = 6;
  #dir = 'ltr';
  #currency = 'KWD';
  #sectionId = '';
  #i18nAr = {
    add:'أضف', empty:'ابدأ بإضافة المنتجات لبناء طقمك.',
    addmore:'أضف {n} منتجات أخرى لتوفير {d}٪',
    addmore_gift:'أضف {n} منتجات أخرى لتوفير {d}٪ + هدية مجانية',
    unlocked:'تم تفعيل خصم {d}٪!', unlocked_gift:'تم تفعيل خصم {d}٪ + هديتك المجانية!',
    complete:'طقمك جاهز!', need_more:'أضف {n} منتجات للمتابعة',
    added:'أُضيف إلى الطقم', removed:'أُزيل من الطقم',
    full:'اكتمل الطقم! الحد الأقصى {n} منتجات.',
    free:'مجاناً', added_cart:'تمت إضافة الطقم إلى السلة!',
    cart_err:'حدث خطأ. حاول مرة أخرى.'
  };

  connectedCallback() {
    const d = this.dataset;
    this.#sectionId = d.sectionId || '';
    this.#min = parseInt(d.min,10) || 3;
    this.#max = parseInt(d.max,10) || 6;
    this.#dir = d.dir || 'ltr';
    this.#currency = d.currency || 'KWD';
    try { this.#tiers = JSON.parse(decodeURIComponent(d.tiers||'[]')); } catch { this.#tiers = []; }
    this.#tiers.sort((a,b)=>a.qty-b.qty);
    try { this.#freeGift = JSON.parse(decodeURIComponent(d.freeGift||'null')); } catch { this.#freeGift = null; }

    this.addEventListener('click', e => this.#onClick(e));
    this.addEventListener('change', e => this.#onChange(e));
    this.#updateUI();
  }

  /* ── i18n ───────────────────────────────────────────────────────────── */
  #t(key, fallback, vars) {
    let s = (this.#dir === 'rtl' && this.#i18nAr[key] != null) ? this.#i18nAr[key] : fallback;
    if (vars) for (const k in vars) s = s.replace(`{${k}}`, vars[k]);
    return s;
  }

  /* ── Events ─────────────────────────────────────────────────────────── */
  #onClick(e) {
    const trg = e.target.closest('[data-action]');
    if (!trg) return;
    const act = trg.dataset.action;

    if (act === 'add') {
      const vId = parseInt(trg.dataset.variantId,10);
      const pId = parseInt(trg.dataset.productId,10);
      this.#add(vId, pId, trg.closest('.byob-card'));
      return;
    }
    if (act === 'remove') {
      this.#removeOne(parseInt(trg.dataset.variantId,10));
      return;
    }
    if (act === 'checkout') { this.#submit(); return; }
  }

  #onChange(e) {
    const sel = e.target.closest('[data-variant-select]');
    if (!sel) return;
    const card = sel.closest('.byob-card');
    const opt = sel.selectedOptions[0];
    const newV = parseInt(sel.value,10);
    const oldV = parseInt(card.dataset.variantId,10);
    const price = parseInt(opt.dataset.price,10);
    const avail = opt.dataset.available === 'true';

    if (this.#sel.has(oldV)) {
      const old = this.#sel.get(oldV);
      this.#sel.delete(oldV);
      this.#sel.set(newV, {...old, variantId:newV, price});
    }
    card.dataset.variantId = newV;
    card.dataset.price = price;
    card.dataset.available = avail;
    const addBtn = card.querySelector('[data-action="add"]');
    if (addBtn) { addBtn.dataset.variantId = newV; addBtn.disabled = !avail; }
    const priceEl = card.querySelector('.byob-card__price');
    if (priceEl) priceEl.textContent = this.#money(price);
    this.#updateUI();
  }

  /* ── Selection ──────────────────────────────────────────────────────── */
  #add(vId, pId, card) {
    if (!vId) return;
    if (this.#payableQty() >= this.#max) {
      this.#hint(this.#t('full', `Bundle full! Max ${this.#max} items.`, {n:this.#max}), 'error');
      return;
    }
    const title = card?.dataset.title || '';
    const price = parseInt(card?.dataset.price || '0', 10);
    const img   = card?.querySelector('.byob-card__img')?.src || '';
    const panel = parseInt(card?.dataset.panel || '0', 10);

    const prevTier = this.#activeTier();
    if (this.#sel.has(vId)) {
      const en = this.#sel.get(vId);
      this.#sel.set(vId, {...en, qty: en.qty + 1});
    } else {
      this.#sel.set(vId, {variantId:vId, productId:pId, title, price, qty:1, img, panel});
    }
    this.#updateUI();
    if (card) { card.classList.remove('just-added'); void card.offsetWidth; card.classList.add('just-added'); setTimeout(()=>card.classList.remove('just-added'),420); }
    this.#announce(`${title} ${this.#t('added','added to bundle')}`);

    const t = this.#activeTier();
    if (t && (!prevTier || t.qty !== prevTier.qty)) this.#announce(this.#rewardMessage());
  }

  #removeOne(vId) {
    const en = this.#sel.get(vId);
    if (!en) return;
    if (en.qty > 1) this.#sel.set(vId, {...en, qty: en.qty - 1});
    else this.#sel.delete(vId);
    this.#updateUI();
    this.#announce(`${en.title} ${this.#t('removed','removed from bundle')}`);
  }

  /* ── Totals / tiers ─────────────────────────────────────────────────── */
  #payableQty() { let n=0; for (const e of this.#sel.values()) if (!e.isGift) n+=e.qty; return n; }
  #orig()  { let s=0; for (const e of this.#sel.values()) if (!e.isGift) s+=e.price*e.qty; return s; }
  #activeTier() { const q=this.#payableQty(); let a=null; for (const t of this.#tiers) if (q>=t.qty) a=t; return a; }
  #nextTier()   { const q=this.#payableQty(); return this.#tiers.find(t=>t.qty>q) || null; }
  #disc() { const t=this.#activeTier(); const o=this.#orig(); return t ? Math.round(o*(1-t.discount/100)) : o; }

  /* ── Free gift ──────────────────────────────────────────────────────── */
  #checkGift() {
    if (!this.#freeGift) return;
    const reached = this.#payableQty() >= this.#freeGift.threshold;
    const toast = this.querySelector('[data-gift]');
    if (reached && !this.#freeGiftAdded) {
      this.#freeGiftAdded = true;
      this.#sel.set('gift_'+this.#freeGift.id, {
        variantId:this.#freeGift.id, productId:this.#freeGift.id,
        title:`${this.#freeGift.title} (${this.#t('free','Free')})`,
        price:0, qty:1, img:this.#freeGift.image, panel:0, isGift:true
      });
      if (toast) { toast.hidden = false; setTimeout(()=>{ toast.hidden = true; }, 4000); }
    } else if (!reached && this.#freeGiftAdded) {
      this.#freeGiftAdded = false;
      this.#sel.delete('gift_'+this.#freeGift.id);
    }
  }

  /* ── UI ─────────────────────────────────────────────────────────────── */
  #updateUI() {
    this.#checkGift();
    this.#renderRail();
    this.#renderCards();
    this.#renderTotals();
    this.#renderReward();
    this.#renderMobile();
    this.#renderCTA();
  }

  // flatten selections to one entry per unit (gift last)
  #units() {
    const u = [];
    for (const e of this.#sel.values()) if (!e.isGift) for (let i=0;i<e.qty;i++) u.push(e);
    for (const e of this.#sel.values()) if (e.isGift) u.push(e);
    return u;
  }

  #renderRail() {
    const track = this.querySelector(`#byob-rail-${this.#sectionId}`);
    if (!track) return;
    const units = this.#units();
    const slots = track.querySelectorAll('.byob-slot');
    slots.forEach((slot, i) => {
      const ring = slot.querySelector('.byob-slot__ring');
      const had = slot.classList.contains('is-filled');
      if (i < units.length) {
        const it = units[i];
        if (!had) {
          ring.innerHTML =
            `<img class="byob-slot__img" src="${this.#esc(it.img)}" alt="${this.#esc(it.title)}" width="56" height="56" loading="lazy">` +
            (it.isGift ? `<span class="byob-slot__qty">${this.#t('free','Free')}</span>` :
              `<button class="byob-slot__remove" type="button" data-action="remove" data-variant-id="${it.variantId}" aria-label="${this.#esc(it.title)} – remove"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>`);
          slot.classList.add('is-filled','just-filled');
          setTimeout(()=>slot.classList.remove('just-filled'),420);
        } else {
          // already filled — refresh image/handlers in case order shifted
          const img = ring.querySelector('.byob-slot__img');
          if (img && img.src !== it.img && it.img) img.src = it.img;
          const rm = ring.querySelector('.byob-slot__remove');
          if (rm) rm.dataset.variantId = it.variantId;
        }
      } else if (had) {
        slot.classList.remove('is-filled');
        ring.innerHTML = `<span class="byob-slot__empty"></span>`;
      }
    });
  }

  #renderCards() {
    const max = this.#max;
    const full = this.#payableQty() >= max;
    this.querySelectorAll('.byob-card').forEach(card => {
      const vId = parseInt(card.dataset.variantId,10);
      const en = this.#sel.get(vId);
      const qty = en?.qty || 0;
      const avail = card.dataset.available === 'true';
      card.classList.toggle('is-selected', qty>0);
      const btn = card.querySelector('[data-action="add"]');
      const cnt = card.querySelector('[data-count]');
      if (btn) btn.disabled = !avail || (full && qty===0);
      if (cnt) { cnt.hidden = qty===0; cnt.textContent = qty; }
    });
  }

  #renderTotals() {
    const o = this.#orig(), d = this.#disc(), saved = o-d, t = this.#activeTier();
    this.querySelectorAll('[data-total]').forEach(el => el.textContent = this.#money(d));
    const origEl = this.querySelector('[data-orig]');
    const saveEl = this.querySelector('[data-save]');
    if (origEl) origEl.textContent = this.#money(o);
    if (saveEl) saveEl.textContent = `- ${this.#money(saved)}`;
    const has = t && saved>0;
    const oRow = this.querySelector('[data-orig-row]');
    const sRow = this.querySelector('[data-save-row]');
    if (oRow) oRow.hidden = !has;
    if (sRow) sRow.hidden = !has;
  }

  #rewardMessage() {
    const q = this.#payableGoalQty();
    const next = this.#nextTier();
    const active = this.#activeTier();
    const giftThresh = this.#freeGift?.threshold;
    const giftPending = giftThresh && q < giftThresh;

    if (next) {
      const n = next.qty - q;
      const key = giftPending ? 'addmore_gift' : 'addmore';
      const fb = giftPending
        ? `Add ${n} more to save ${next.discount}% + a free mini`
        : `Add ${n} more to save ${next.discount}%`;
      return this.#t(key, fb, {n, d:next.discount});
    }
    if (active) {
      const reachedGift = this.#freeGiftAdded;
      const key = reachedGift ? 'unlocked_gift' : 'unlocked';
      const fb = reachedGift
        ? `You unlocked ${active.discount}% off + your free mini!`
        : `You unlocked ${active.discount}% off!`;
      return this.#t(key, fb, {d:active.discount});
    }
    return '';
  }

  // qty used to measure reward progress (payable, capped sensibly)
  #payableGoalQty() { return this.#payableQty(); }

  #renderReward() {
    const msg = this.#rewardMessage() || this.#t('empty','Start adding products to build your bundle.');
    this.querySelectorAll('[data-rail-msg]').forEach(el => el.textContent = msg);
    const heroEl = this.querySelector('[data-reward]');
    if (heroEl) heroEl.textContent = msg;

    // progress bar toward next tier (full when the top tier is reached)
    const fill = this.querySelector('[data-reward-fill]');
    if (fill) {
      const q = this.#payableQty();
      const next = this.#nextTier();
      const active = this.#activeTier();
      let pct = 0;
      if (next) {
        const from = active ? active.qty : 0;
        pct = ((q - from) / (next.qty - from)) * 100;
      } else if (active) {
        pct = 100;
      } else if (this.#tiers.length) {
        pct = (q / this.#tiers[0].qty) * 100;
      }
      fill.style.width = `${Math.min(100, Math.max(0, pct))}%`;
    }
  }

  #renderMobile() {
    const wrap = document.querySelector(`#byob-mobilebar-${this.#sectionId} [data-mobile-slots]`);
    if (!wrap) return;
    const units = this.#units();
    const shownEmpties = Math.max(0, Math.min(this.#max - units.length, 4));
    const parts = [];
    units.slice(0, 6).forEach((it,idx) => {
      parts.push(
        `<span class="byob-mslot">` +
        `<img class="byob-mslot__img" src="${this.#esc(it.img)}" alt="" width="38" height="38">` +
        (it.isGift ? '' : `<button class="byob-mslot__remove" type="button" data-action="remove" data-variant-id="${it.variantId}" aria-label="remove">✕</button>`) +
        `</span>`
      );
    });
    for (let i=0;i<shownEmpties;i++) parts.push(`<span class="byob-mslot"><span class="byob-mslot__empty"></span></span>`);
    wrap.innerHTML = parts.join(`<span class="byob-mslot__sep">–</span>`);
  }

  #renderCTA() {
    const ready = this.#payableQty() >= this.#min;
    this.querySelectorAll('[data-action="checkout"]').forEach(btn => {
      btn.disabled = !ready;
      btn.setAttribute('aria-disabled', String(!ready));
    });
    const hint = this.querySelector('[data-hint]');
    if (hint && !hint.classList.contains('is-error') && !hint.classList.contains('is-success')) {
      const need = this.#min - this.#payableQty();
      hint.textContent = ready ? '' : this.#t('need_more', `Add ${need} more item(s) to proceed`, {n:need});
    }
  }

  /* ── Submit ─────────────────────────────────────────────────────────── */
  async #submit() {
    if (this.#payableQty() < this.#min) return;
    const tier = this.#activeTier();
    const key = `bundle-${Date.now()}`;
    const items = [];
    for (const e of this.#sel.values()) {
      if (e.isGift) continue;
      items.push({ id:e.variantId, quantity:e.qty, properties:{
        _bundle_id:key, _bundle_discount_pct: tier ? String(tier.discount) : '0'
      }});
    }
    if (this.#freeGiftAdded && this.#freeGift) {
      items.push({ id:this.#freeGift.id, quantity:1, properties:{ _bundle_id:key, _free_gift:'true' }});
    }

    const ctas = [...this.querySelectorAll('[data-action="checkout"]')];
    ctas.forEach(b => { b.classList.add('is-loading'); b.disabled = true; const s=b.querySelector('.byob-cta__spin'); if(s)s.hidden=false; });

    try {
      const resp = await fetch('/cart/add.js', {
        method:'POST',
        headers:{'Content-Type':'application/json','X-Requested-With':'XMLHttpRequest'},
        body: JSON.stringify({ items })
      });
      if (!resp.ok) { const er = await resp.json().catch(()=>({})); throw new Error(er.description || resp.statusText); }
      this.#hint(this.#t('added_cart','Bundle added to cart!'), 'success');
      this.#announce(this.#t('added_cart','Bundle added to cart!'));
      if (this.dataset.redirect === 'true') window.location.href = '/cart';
      else document.dispatchEvent(new CustomEvent('cart:refresh'));
    } catch (err) {
      this.#hint(err.message || this.#t('cart_err','Something went wrong. Please try again.'), 'error');
    } finally {
      ctas.forEach(b => { b.classList.remove('is-loading'); const s=b.querySelector('.byob-cta__spin'); if(s)s.hidden=true; });
      this.#renderCTA();
    }
  }

  /* ── Helpers ────────────────────────────────────────────────────────── */
  #money(amount) {
    const c = this.#currency || 'KWD';
    const dec = (c==='KWD'||c==='BHD'||c==='OMR') ? 3 : 2;
    return `${c} ${(amount/Math.pow(10,dec)).toFixed(dec)}`;
  }
  #esc(s) { return String(s||'').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m])); }
  #hint(msg, type) {
    const h = this.querySelector('[data-hint]');
    if (!h) return;
    h.textContent = msg;
    h.classList.toggle('is-error', type==='error');
    h.classList.toggle('is-success', type==='success');
    if (type) setTimeout(()=>{ h.classList.remove('is-error','is-success'); this.#renderCTA(); }, 3500);
  }
  #announce(msg) { const sr = this.querySelector('[data-sr]'); if (sr) sr.textContent = msg; }
}

if (!customElements.get('bundle-builder')) customElements.define('bundle-builder', BundleBuilder);
})();
</script>

