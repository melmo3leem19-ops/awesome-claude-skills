    this.#bundleType  = this.dataset.bundleType || 'mix_match';
    this.#minQty      = parseInt(this.dataset.min, 10) || 1;
    this.#maxQty      = parseInt(this.dataset.max, 10) || 6;
    this.#dir         = this.dataset.dir || document.documentElement.dir || 'ltr';
    this.#locale      = this.dataset.locale || 'en';
    this.#currency    = this.dataset.currency || 'KWD';
    this.#wizardAnim  = this.dataset.wizardAnimation || 'slide';

    try { this.#tiers = JSON.parse(decodeURIComponent(this.dataset.tiers || '[]')); } catch { this.#tiers = []; }
    try { this.#freeGift = JSON.parse(decodeURIComponent(this.dataset.freeGift || 'null')); } catch { this.#freeGift = null; }

    const tagStr    = this.dataset.filterTags    || '';
    const vendorStr = this.dataset.filterVendors || '';
    this.#filterTags    = tagStr.split(',').map(s => s.trim()).filter(Boolean);
    this.#filterVendors = vendorStr.split(',').map(s => s.trim()).filter(Boolean);

    // Count wizard panels
    const panels = this.querySelectorAll('.bb-step-panel, .bb-panel');
    this.#wizardTotal = panels.length;

    this.#bindEvents();
    this.#initRequired();
    this.#renderTiers();
    this.#updateUI();
    this.#initTimer();
    this.#initSearch();
    this.#prefetchInventory();
    this.#initMobileDrawer();
    this.#announceReady();

    // Wizard step panel animations
    if (this.#bundleType === 'wizard') {
      this.#syncWizardStepPanels();
    }
  }

  disconnectedCallback() {
    if (this.#timerInterval) clearInterval(this.#timerInterval);
  }

  /* ── Event binding ───────────────────────────────────────────────── */
  #bindEvents() {
    // Delegate all clicks/changes within the component
    this.addEventListener('click',  e => this.#onClick(e));
    this.addEventListener('change', e => this.#onChange(e));
    this.addEventListener('keydown', e => this.#onKeydown(e));

    // Mobile drawer handle (outside bundle-builder element, in same section)
    const section = document.getElementById(`bundle-builder-${this.#sectionId}`);
    if (section) {
      const handle = section.querySelector('.bb-mobile-drawer__handle');
      if (handle) {
        handle.addEventListener('click', () => this.#toggleDrawer());
        handle.addEventListener('keydown', e => {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); this.#toggleDrawer(); }
        });
      }
    }

    // Quick view dialog close on backdrop click
    const dialog = this.querySelector('.bb-quick-view-dialog');
    if (dialog) {
      dialog.addEventListener('click', e => {
        if (e.target === dialog) dialog.close();
      });
    }
  }

  #onClick(e) {
    const t = e.target.closest('[data-action]');
    if (t) {
      e.stopPropagation();
      const action    = t.dataset.action;
      const variantId = parseInt(t.dataset.variantId, 10);
      const productId = parseInt(t.dataset.productId, 10);
      if (action === 'add')    this.#addToSelection(variantId, productId, t);
      if (action === 'remove') this.#removeFromSelection(variantId, productId, t);
      return;
    }

    // Tab click
    const tab = e.target.closest('.bb-tab');
    if (tab) { this.#switchTab(parseInt(tab.dataset.tab, 10)); return; }

    // Wizard step button
    const wizBtn = e.target.closest('.bb-wizard-step-btn');
    if (wizBtn) { this.#goToWizardStep(parseInt(wizBtn.dataset.step, 10)); return; }

    // Wizard next/prev
    if (e.target.closest(`#bb-next-${this.#sectionId}`)) { this.#wizardNext(); return; }
    if (e.target.closest(`#bb-prev-${this.#sectionId}`)) { this.#wizardPrev(); return; }

    // CTA
    if (e.target.closest(`#bb-cta-${this.#sectionId}`) || e.target.closest('.bb-cta-btn--drawer')) {
      this.#submitBundle(); return;
    }

    // Quick view
    const qvBtn = e.target.closest('.bb-product-card__quick-view');
    if (qvBtn) { this.#openQuickView(qvBtn.dataset.productHandle); return; }

    // Close quick view
    if (e.target.closest('.bb-quick-view-close')) {
      this.querySelector('.bb-quick-view-dialog')?.close(); return;
    }

    // Sidebar qty buttons
    const sideQtyBtn = e.target.closest('.bb-selection-item__qty-btn');
    if (sideQtyBtn) {
      const varId = parseInt(sideQtyBtn.closest('.bb-selection-item').dataset.variantId, 10);
      if (sideQtyBtn.dataset.dir === 'up')   this.#incrementSelection(varId);
      if (sideQtyBtn.dataset.dir === 'down') this.#decrementSelection(varId);
      return;
    }

    // Card click — toggle add (if single-select card, not on button)
    const card = e.target.closest('.bb-product-card');
    if (card && !e.target.closest('button') && !e.target.closest('select')) {
      const variantId = parseInt(card.dataset.variantId, 10);
      const productId = parseInt(card.dataset.productId, 10);
      const available = card.dataset.available === 'true';
      if (!available) return;
      if (this.#selections.has(variantId)) {
        this.#decrementSelection(variantId);
      } else {
        this.#addToSelection(variantId, productId, card);
      }
    }
  }

  #onChange(e) {
    // Variant select change — update card's data-variant-id and price
    const sel = e.target.closest('.bb-product-card__variant-select');
    if (sel) {
      const card      = sel.closest('.bb-product-card');
      const opt       = sel.selectedOptions[0];
      const newVarId  = parseInt(sel.value, 10);
      const oldVarId  = parseInt(card.dataset.variantId, 10);
      const newPrice  = parseInt(opt.dataset.price, 10);
      const available = opt.dataset.available === 'true';

      // If old variant was selected, swap it
      if (this.#selections.has(oldVarId)) {
        const old = this.#selections.get(oldVarId);
        this.#selections.delete(oldVarId);
        this.#selections.set(newVarId, { ...old, variantId: newVarId, price: newPrice });
      }

      card.dataset.variantId = newVarId;
      card.dataset.price     = newPrice;
      card.dataset.available = available;

      const addBtn = card.querySelector('[data-action="add"]');
      if (addBtn) {
        addBtn.dataset.variantId = newVarId;
        addBtn.disabled = !available;
        addBtn.setAttribute('aria-disabled', String(!available));
      }
      const remBtn = card.querySelector('[data-action="remove"]');
      if (remBtn) remBtn.dataset.variantId = newVarId;

      const priceEl = card.querySelector('.bb-product-card__price');
      if (priceEl) priceEl.textContent = this.#formatMoney(newPrice);

      this.#updateUI();
    }
  }

  #onKeydown(e) {
    const card = e.target.closest('.bb-product-card');
    if (card && (e.key === 'Enter' || e.key === ' ')) {
      e.preventDefault();
      card.querySelector('[data-action="add"]')?.click();
    }
  }

  /* ── Selection management ────────────────────────────────────────── */
  #addToSelection(variantId, productId, source) {
    if (!variantId || !productId) return;
    const total = this.#totalQuantity();

    if (total >= this.#maxQty) {
      this.#showHint(this.#dir === 'rtl' ? `اكتمل الطقم! الحد الأقصى ${this.#maxQty} منتجات.` : `Bundle full! Max ${this.#maxQty} items.`, 'error');
      return;
    }

    const card    = source.closest('.bb-product-card') || this.querySelector(`[data-variant-id="${variantId}"]`);
    const title   = card?.dataset.title   || '';
    const price   = parseInt(card?.dataset.price || '0', 10);
    const img     = card?.querySelector('.bb-product-card__img')?.src || '';
    const handle  = card?.dataset.handle  || '';
    const panel   = parseInt(card?.dataset.panel || '1', 10);
    const isReq   = card?.dataset.required === 'true';

    if (this.#selections.has(variantId)) {
      const entry = this.#selections.get(variantId);
      this.#selections.set(variantId, { ...entry, qty: entry.qty + 1 });
    } else {
      this.#selections.set(variantId, { variantId, productId, title, price, qty: 1, img, handle, panelIndex: panel, isRequired: isReq });
    }

    this.#updateUI();
    this.#track('bundle_product_add', { variantId, title, price });
    this.#srAnnounce(`${title} ${this.#t('added_to_bundle', 'added to bundle')}`);
  }

  #removeFromSelection(variantId, productId, source) {
    if (!this.#selections.has(variantId)) return;
    const entry = this.#selections.get(variantId);
    if (entry.isRequired) {
      this.#showHint(this.#t('required_item', 'This item is required in the bundle.'), 'error');
      return;
    }
    if (entry.qty > 1) {
      this.#selections.set(variantId, { ...entry, qty: entry.qty - 1 });
    } else {
      this.#selections.delete(variantId);
    }
    this.#updateUI();
    this.#track('bundle_product_remove', { variantId, title: entry.title });
    this.#srAnnounce(`${entry.title} ${this.#t('removed_from_bundle', 'removed from bundle')}`);
  }

  #incrementSelection(variantId) {
    if (!this.#selections.has(variantId)) return;
    if (this.#totalQuantity() >= this.#maxQty) { this.#showHint(this.#t('bundle_full', 'Bundle full!'), 'error'); return; }
    const entry = this.#selections.get(variantId);
    this.#selections.set(variantId, { ...entry, qty: entry.qty + 1 });
    this.#updateUI();
  }

  #decrementSelection(variantId) {
    if (!this.#selections.has(variantId)) return;
    const entry = this.#selections.get(variantId);
    if (entry.isRequired) { this.#showHint(this.#t('required_item', 'Required item cannot be removed.'), 'error'); return; }
    if (entry.qty > 1) {
      this.#selections.set(variantId, { ...entry, qty: entry.qty - 1 });
    } else {
      this.#selections.delete(variantId);
    }
    this.#updateUI();
  }

  /* ── Required products init ──────────────────────────────────────── */
  #initRequired() {
    this.querySelectorAll('.bb-product-card[data-required="true"]').forEach(card => {
      const variantId = parseInt(card.dataset.variantId, 10);
      const productId = parseInt(card.dataset.productId, 10);
      if (!this.#selections.has(variantId)) {
        this.#addToSelection(variantId, productId, card);
      }
    });
  }

  /* ── Tiered discount ─────────────────────────────────────────────── */
  #activeTier() {
    const total = this.#totalQuantity();
    let active = null;
    for (const tier of this.#tiers) {
      if (total >= tier.qty) active = tier;
    }
    return active;
  }

  #nextTier() {
    const total = this.#totalQuantity();
    return this.#tiers.find(t => t.qty > total) || null;
  }

  #renderTiers() {
    const tierBadges = this.querySelectorAll('.bb-tier-badge');
    const total = this.#totalQuantity();
    const active = this.#activeTier();
    const next   = this.#nextTier();

    tierBadges.forEach(badge => {
      const qty = parseInt(badge.dataset.qty, 10);
      badge.classList.remove('is-active', 'is-next');
      if (active && qty === active.qty) badge.classList.add('is-active');
      else if (next && qty === next.qty) badge.classList.add('is-next');
    });

    // Sidebar active discount display
    const discEl = this.querySelector('.bb-active-discount');
    const nextEl  = this.querySelector('.bb-next-tier-hint');

    if (discEl) {
      if (active) {
        discEl.hidden = false;
        const textEl = discEl.querySelector('.bb-active-discount__text');
        if (textEl) textEl.textContent = active.label || `${active.discount}% ${this.#t('off', 'off')}`;
        discEl.style.setProperty('--tier-active-color', active.color || 'var(--bb-color-tier-1)');
        discEl.style.borderColor = active.color || '';
      } else {
        discEl.hidden = true;
      }
    }

    if (nextEl) {
      if (next) {
        nextEl.hidden = false;
        const needed = next.qty - total;
        const textEl = nextEl.querySelector('.bb-next-tier-hint__text');
        if (textEl) {
          textEl.textContent = this.#dir === 'rtl' ? `أضف ${needed} للحصول على خصم ${next.discount}%` : `Add ${needed} more for ${next.discount}% off`;
        }
      } else {
        nextEl.hidden = true;
      }
    }
  }

  /* ── Totals ──────────────────────────────────────────────────────── */
  #totalQuantity() {
    let total = 0;
    for (const { qty } of this.#selections.values()) total += qty;
    return total;
  }

  #originalTotal() {
    let sum = 0;
    for (const { price, qty } of this.#selections.values()) sum += price * qty;
    return sum;
  }

  #discountedTotal() {
    const tier = this.#activeTier();
    const orig = this.#originalTotal();
    if (!tier) return orig;
    return Math.round(orig * (1 - tier.discount / 100));
  }

  /* ── Free gift ───────────────────────────────────────────────────── */
  #checkFreeGift() {
    if (!this.#freeGift) return;
    const total = this.#totalQuantity();
    const banner = this.querySelector('.bb-free-gift-banner');

    if (total >= this.#freeGift.threshold) {
      if (banner) banner.hidden = false;
      if (!this.#freeGiftAdded) {
        this.#freeGiftAdded = true;
        // Auto-add free gift variant to selections at price 0
        const giftId = this.#freeGift.id;
        this.#selections.set(giftId, {
          variantId: giftId,
          productId: giftId,
          title: `${this.#freeGift.title} (${this.#t('free', 'Free')})`,
          price: 0,
          qty: 1,
          img: this.#freeGift.image,
          panelIndex: 0,
          isRequired: true,
          isGift: true
        });
        this.#srAnnounce(this.#t('free_gift_unlocked', "Free gift unlocked!"));
      }
    } else {
      if (banner) banner.hidden = true;
      if (this.#freeGiftAdded) {
        this.#freeGiftAdded = false;
        this.#selections.delete(this.#freeGift.id);
      }
    }
  }

  /* ── Main UI update ──────────────────────────────────────────────── */
  #updateUI() {
    this.#checkFreeGift();
    this.#renderTiers();
    this.#renderProgress();
    this.#renderSelectionList();
    this.#renderPriceSummary();
    this.#renderCardStates();
    this.#renderCTA();
    this.#renderMobileDrawerPreview();

    if (this.#bundleType === 'wizard') {
      this.#renderWizardControls();
    }
  }

  /* ── Progress bar ────────────────────────────────────────────────── */
  #renderProgress() {
    const total = this.#totalQuantity();
    const pct   = Math.min(100, (total / this.#maxQty) * 100);

    const fill    = this.querySelector('.bb-progress-fill');
    const bar     = this.querySelector('.bb-progress-bar');
    const current = this.querySelector('.bb-progress-current');
    const remaining = this.querySelector('.bb-progress-remaining');
    const hint    = this.querySelector('.bb-progress-hint');

    if (fill)  { fill.style.width = `${pct}%`; }
    if (bar)   { bar.setAttribute('aria-valuenow', total); }
    if (current) current.textContent = total;
    if (remaining) remaining.textContent = Math.max(0, this.#maxQty - total);

    if (hint && total >= this.#maxQty) {
      hint.textContent = this.#t('bundle_complete', 'Bundle complete! Ready to add to cart.');
    }
  }

  /* ── Selection list (sidebar) ────────────────────────────────────── */
  #renderSelectionList() {
    const list = this.querySelector('.bb-selection-list');
    if (!list) return;

    if (this.#selections.size === 0) {
      list.innerHTML = `<li class="bb-selection-empty">${this.#t('empty_state', 'Your bundle is empty. Start adding products!')}</li>`;
      return;
    }

    const items = [];
    for (const [varId, entry] of this.#selections) {
      items.push(`
        <li class="bb-selection-item" data-variant-id="${varId}">
          <img
            class="bb-selection-item__img"
            src="${entry.img || ''}"
            alt="${this.#escHtml(entry.title)}"
            loading="lazy"
            width="40" height="40"
            onerror="this.style.visibility='hidden'"
          >
          <div class="bb-selection-item__info">
            <div class="bb-selection-item__title">${this.#escHtml(entry.title)}</div>
            <div class="bb-selection-item__price">${this.#formatMoney(entry.price * entry.qty)}</div>
          </div>
          <div class="bb-selection-item__qty-controls">
            <button class="bb-selection-item__qty-btn" data-dir="down" aria-label="${this.#t('decrease_qty', 'Decrease quantity')}" ${entry.isRequired && entry.qty <= 1 ? 'disabled' : ''}>−</button>
            <span class="bb-selection-item__qty" aria-label="${this.#t('quantity', 'Quantity')}: ${entry.qty}">${entry.qty}</span>
            <button class="bb-selection-item__qty-btn" data-dir="up" aria-label="${this.#t('increase_qty', 'Increase quantity')}" ${this.#totalQuantity() >= this.#maxQty ? 'disabled' : ''}>+</button>
          </div>
        </li>
      `);
    }
    list.innerHTML = items.join('');
  }

  /* ── Price summary ───────────────────────────────────────────────── */
  #renderPriceSummary() {
    const orig  = this.#originalTotal();
    const disc  = this.#discountedTotal();
    const saved = orig - disc;
    const tier  = this.#activeTier();

    const totalEl   = this.querySelector('.bb-bundle-total');
    const origRow   = this.querySelector('.bb-price-row--original');
    const origEl    = this.querySelector('.bb-original-total');
    const savRow    = this.querySelector('.bb-price-row--savings');
    const savEl     = this.querySelector('.bb-savings-amount');

    if (totalEl)  totalEl.textContent  = this.#formatMoney(disc);
    if (origEl)   origEl.textContent   = this.#formatMoney(orig);
    if (savEl)    savEl.textContent    = `- ${this.#formatMoney(saved)}`;

    const hasSaving = tier && saved > 0;
    if (origRow)  origRow.hidden = !hasSaving;
    if (savRow)   savRow.hidden  = !hasSaving;
  }

  /* ── Card states ─────────────────────────────────────────────────── */
  #renderCardStates() {
    const total = this.#totalQuantity();
    const atMax = total >= this.#maxQty;

    this.querySelectorAll('.bb-product-card').forEach(card => {
      const varId = parseInt(card.dataset.variantId, 10);
      const entry = this.#selections.get(varId);
      const qty   = entry?.qty || 0;
      const available = card.dataset.available === 'true';

      card.classList.toggle('is-selected', qty > 0);

      const addBtn  = card.querySelector('[data-action="add"]');
      const remBtn  = card.querySelector('[data-action="remove"]');
      const qtyDisp = card.querySelector('.bb-product-card__qty-display');

      if (addBtn) {
        const shouldDisable = !available || (atMax && qty === 0);
        addBtn.disabled = shouldDisable;
        addBtn.setAttribute('aria-disabled', String(shouldDisable));
        if (qty > 0) {
          addBtn.querySelector('.bb-btn-label').textContent = this.#t('add_more', 'Add More');
        } else {
          addBtn.querySelector('.bb-btn-label').textContent = this.#t('add', 'Add');
        }
      }

      if (remBtn) {
        remBtn.hidden = qty === 0;
        remBtn.disabled = entry?.isRequired && qty <= 1;
      }

      if (qtyDisp) {
        qtyDisp.hidden = qty === 0;
        qtyDisp.textContent = qty;
        qtyDisp.setAttribute('aria-label', `${this.#t('quantity', 'Quantity')}: ${qty}`);
      }
    });
  }

  /* ── CTA state ───────────────────────────────────────────────────── */
  #renderCTA() {
    const total    = this.#totalQuantity();
    const ready    = total >= this.#minQty;
    const ctaBtn   = this.querySelector(`#bb-cta-${this.#sectionId}`);
    const drawerCta = this.closest('.bundle-builder-section')?.querySelector('.bb-cta-btn--drawer');

    [ctaBtn, drawerCta].forEach(btn => {
      if (!btn) return;
      btn.disabled = !ready;
      btn.setAttribute('aria-disabled', String(!ready));
    });

    const hint = this.querySelector('.bb-cta-hint');
    if (hint && !hint.classList.contains('is-error') && !hint.classList.contains('is-success')) {
      if (!ready) {
        const needed = this.#minQty - total;
        hint.textContent = this.#dir === 'rtl' ? `أضف ${needed} منتجات للمتابعة` : `Add ${needed} more item(s) to proceed`;
      } else {
        hint.textContent = '';
      }
    }
  }

  /* ── Wizard ──────────────────────────────────────────────────────── */
  #syncWizardStepPanels() {
    const panels = this.querySelectorAll('.bb-step-panel');
    const anim   = this.#wizardAnim;
    panels.forEach(p => p.dataset.animation = anim);
  }

  /**
   * Restart the step-panel entrance animation every time a panel is shown.
   *
   * CSS @keyframes animations only fire when an element FIRST matches the
   * animation selector. Re-toggling `is-active` on a panel that was
   * `display:none` will NOT replay the animation on its own — the browser
   * needs a forced reflow between clearing and re-applying the animation.
   * We also flip the slide direction for "back" navigation and for RTL.
   */
  #playStepTransition(panel, goingBack) {
    if (!panel) return;

    // Respect the visitor's reduced-motion preference — skip animation.
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    let anim = this.#wizardAnim || 'slide';

    // For "slide", pick the axis that reads correctly for direction + locale.
    // Forward in LTR slides in from the end (right); back slides from start.
    // RTL mirrors both. `slide-back` / `slide-rtl*` map to dedicated keyframes.
    if (anim === 'slide') {
      const rtl = this.#dir === 'rtl';
      if (goingBack) {
        anim = rtl ? 'slide' : 'slide-back';
      } else {
        anim = rtl ? 'slide-rtl' : 'slide';
      }
    }

    // Clear, force a reflow, then re-apply so the keyframes restart cleanly.
    panel.dataset.animation = '';
    // eslint-disable-next-line no-unused-expressions
    void panel.offsetWidth; // forced reflow — do not remove
    panel.dataset.animation = anim;
  }

  #goToWizardStep(step) {
    if (step < 1 || step > this.#wizardTotal) return;
    const canAdvance = this.#wizardStepIsComplete(this.#wizardStep);
    if (step > this.#wizardStep && !canAdvance) {
      this.#showHint(this.#t('complete_step', 'Complete this step first.'), 'error');
      return;
    }

    // Direction of travel — used to flip the slide axis (and to honour RTL).
    const goingBack = step < this.#wizardStep;

    const panels   = this.querySelectorAll('.bb-step-panel, .bb-panel');
    const stepBtns = this.querySelectorAll('.bb-wizard-step-btn');

    panels.forEach((p, i) => {
      const willBeActive = i + 1 === step;
      p.classList.toggle('is-active', willBeActive);
      if (willBeActive) this.#playStepTransition(p, goingBack);
    });
    stepBtns.forEach(btn => {
      const n = parseInt(btn.dataset.step, 10);
      btn.classList.toggle('is-active', n === step);
      btn.setAttribute('aria-selected', String(n === step));
      btn.classList.toggle('is-complete', n < step);
    });

    this.#wizardStep = step;

    // Update progress text
    const curr = this.querySelector('.bb-wizard-step-current');
    if (curr) curr.textContent = step;

    this.#renderWizardControls();
    this.#srAnnounce(this.#dir === 'rtl' ? `خطوة ${step} من ${this.#wizardTotal}` : `Step ${step} of ${this.#wizardTotal}`);
  }

  #wizardNext() { this.#goToWizardStep(this.#wizardStep + 1); }
  #wizardPrev() { this.#goToWizardStep(this.#wizardStep - 1); }

  #wizardStepIsComplete(step) {
    const panel = this.querySelector(`.bb-step-panel[data-panel="${step}"], .bb-panel[data-panel="${step}"]`);
    if (!panel) return true;
    const stepMin = parseInt(panel.dataset.stepMin, 10) || 1;
    // Count selections belonging to this panel
    let panelQty = 0;
    for (const entry of this.#selections.values()) {
      if (entry.panelIndex === step) panelQty += entry.qty;
    }
    return panelQty >= stepMin;
  }

  #renderWizardControls() {
    const prevBtn = this.querySelector(`#bb-prev-${this.#sectionId}`);
    const nextBtn = this.querySelector(`#bb-next-${this.#sectionId}`);
    if (!prevBtn || !nextBtn) return;

    prevBtn.hidden   = this.#wizardStep <= 1;
    prevBtn.disabled = this.#wizardStep <= 1;

    const isLast = this.#wizardStep >= this.#wizardTotal;
    nextBtn.hidden   = isLast;
    nextBtn.disabled = isLast || !this.#wizardStepIsComplete(this.#wizardStep);

    // On last step, CTA becomes primary action — ensure visibility
    const ctaBtn = this.querySelector(`#bb-cta-${this.#sectionId}`);
    if (ctaBtn) {
      ctaBtn.style.display = isLast ? '' : 'none';
    }
  }

  /* ── Cart submission ─────────────────────────────────────────────── */
  async #submitBundle() {
    if (this.#totalQuantity() < this.#minQty) return;

    const ctaBtn = this.querySelector(`#bb-cta-${this.#sectionId}`);
    const spinner = ctaBtn?.querySelector('.bb-cta-btn__spinner');
    const label   = ctaBtn?.querySelector('.bb-cta-btn__label');

    if (ctaBtn) { ctaBtn.classList.add('is-loading'); ctaBtn.disabled = true; }
    if (spinner) spinner.hidden = false;
    if (label)   label.style.opacity = '0';

    const tier = this.#activeTier();
    const bundleKey = `bundle-${Date.now()}`;

    const items = [];
    for (const [varId, entry] of this.#selections) {
      if (entry.isGift) continue; // free gift added separately
      const props = {
        _bundle_id:           bundleKey,
        _bundle_type:         this.#bundleType,
        _bundle_discount_pct: tier ? String(tier.discount) : '0',
      };
      if (entry.panelIndex) props._bundle_step = String(entry.panelIndex);

      items.push({ id: varId, quantity: entry.qty, properties: props });
    }

    // Add free gift if applicable
    if (this.#freeGiftAdded && this.#freeGift) {
      items.push({
        id: this.#freeGift.id,
        quantity: 1,
        properties: { _bundle_id: bundleKey, _bundle_type: 'free_gift', _free_gift: 'true' }
      });
    }

    try {
      const resp = await fetch('/cart/add.js', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body:    JSON.stringify({ items }),
      });

      if (!resp.ok) {
        const err = await resp.json().catch(() => ({ description: 'Unknown error' }));
        throw new Error(err.description || resp.statusText);
      }

      this.#track('bundle_add_to_cart', {
        bundle_type: this.#bundleType,
        total_qty:   this.#totalQuantity(),
        total_value: this.#discountedTotal(),
        discount:    tier?.discount || 0,
      });

      this.#showHint(this.#t('added_to_cart', 'Bundle added to cart!'), 'success');
      this.#srAnnounce(this.#t('added_to_cart', 'Bundle added to cart!'));

      // Optional redirect to cart
      if (this.dataset.redirectToCart === 'true') {
        window.location.href = '/cart';
      }

    } catch (err) {
      this.#showHint(err.message || this.#t('cart_error', 'Something went wrong. Please try again.'), 'error');
    } finally {
      if (ctaBtn) { ctaBtn.classList.remove('is-loading'); ctaBtn.disabled = false; }
      if (spinner) spinner.hidden = true;
      if (label)   label.style.opacity = '';
      this.#renderCTA();
    }
  }

  /* ── Tab switching ───────────────────────────────────────────────── */
  #switchTab(tabIndex) {
    const tabs   = this.querySelectorAll('.bb-tab');
    const panels = this.querySelectorAll('.bb-panel');

    tabs.forEach(t => {
      const active = parseInt(t.dataset.tab, 10) === tabIndex;
      t.classList.toggle('is-active', active);
      t.setAttribute('aria-selected', String(active));
    });

    panels.forEach(p => {
      const active = parseInt(p.dataset.panel, 10) === tabIndex;
      p.classList.toggle('is-active', active);
    });
  }

  /* ── Mobile drawer ───────────────────────────────────────────────── */
  #initMobileDrawer() {
    const section = document.getElementById(`bundle-builder-${this.#sectionId}`);
    const drawer  = section?.querySelector('.bb-mobile-drawer');
    if (drawer) drawer.setAttribute('aria-hidden', 'false');
  }

  #toggleDrawer() {
    const section = document.getElementById(`bundle-builder-${this.#sectionId}`);
    const drawer  = section?.querySelector('.bb-mobile-drawer');
    if (!drawer) return;
    const isOpen = drawer.classList.toggle('is-open');
    drawer.setAttribute('aria-hidden', String(!isOpen));
    if (isOpen) this.#cloneSidebarToDrawer();
  }

  #cloneSidebarToDrawer() {
    const section = document.getElementById(`bundle-builder-${this.#sectionId}`);
    const inner   = section?.querySelector('.bb-mobile-drawer__inner');
    const sidebar = this.querySelector('.bb-selection-summary');
    if (inner && sidebar) inner.innerHTML = sidebar.outerHTML;
  }

  #renderMobileDrawerPreview() {
    const section = document.getElementById(`bundle-builder-${this.#sectionId}`);
    if (!section) return;
    const qtyEl   = section.querySelector('.bb-drawer-qty');
    const totalEl = section.querySelector('.bb-drawer-total');
    if (qtyEl)   qtyEl.textContent   = this.#totalQuantity();
    if (totalEl) totalEl.textContent = this.#formatMoney(this.#discountedTotal());

    const drawerCta = section.querySelector('.bb-cta-btn--drawer');
    if (drawerCta) {
      const ready = this.#totalQuantity() >= this.#minQty;
      drawerCta.disabled = !ready;
      drawerCta.setAttribute('aria-disabled', String(!ready));
    }
  }

  /* ── Quick view ──────────────────────────────────────────────────── */
  async #openQuickView(handle) {
    const dialog  = this.querySelector('.bb-quick-view-dialog');
    const content = this.querySelector('.bb-quick-view-content');
    if (!dialog || !content || !handle) return;

    content.innerHTML = `<div class="bb-quick-view-loading"><div class="bb-spinner"></div></div>`;
    dialog.showModal?.() || dialog.setAttribute('open', '');

    try {
      const resp = await fetch(`/products/${handle}?view=json`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
      if (!resp.ok) throw new Error('Not found');
      const html = await resp.text();

      // Fallback: load from products/{handle}.js
      const jsonResp = await fetch(`/products/${handle}.js`);
      const data = await jsonResp.json();

      content.innerHTML = `
        <div class="bb-quick-view-inner">
          <img
            src="${data.featured_image || ''}"
            alt="${this.#escHtml(data.title)}"
            loading="lazy"
            width="400" height="400"
          >
          <div class="bb-quick-view-inner__info">
            <p style="font-size:.75rem;text-transform:uppercase;letter-spacing:.06em;color:var(--bb-color-text-muted)">${this.#escHtml(data.vendor)}</p>
            <h3 style="margin:0 0 .5rem;font-size:1.25rem">${this.#escHtml(data.title)}</h3>
            <p style="font-weight:700;font-size:1.1rem">${this.#formatMoney(data.price)}</p>
            <p style="font-size:.875rem;color:var(--bb-color-text-muted);line-height:1.6">${data.description?.replace(/<[^>]+>/g, '').slice(0, 200) || ''}…</p>
            <a href="/products/${handle}" style="font-size:.875rem;color:var(--bb-color-accent)">
              ${this.#t('view_full', 'View full product')} →
            </a>
          </div>
        </div>
      `;
    } catch {
      content.innerHTML = `<p style="padding:2rem;text-align:center">${this.#t('quick_view_error', 'Could not load product details.')}</p>`;
    }
  }

  /* ── Inventory async check ───────────────────────────────────────── */
  async #prefetchInventory() {
    const cards = this.querySelectorAll('.bb-product-card[data-handle]');
    const handles = [...new Set([...cards].map(c => c.dataset.handle).filter(Boolean))];

    // Stagger requests to avoid hammering the server
    for (const handle of handles.slice(0, 20)) {
      if (this.#inventoryCache.has(handle)) continue;
      try {
        const resp = await fetch(`/products/${handle}.js`, { priority: 'low' });
        if (!resp.ok) continue;
        const data = await resp.json();
        const available = data.available === true;
        this.#inventoryCache.set(handle, available);

        // Update any card with this handle
        this.querySelectorAll(`[data-handle="${handle}"]`).forEach(card => {
          const wasAvailable = card.dataset.available === 'true';
          if (wasAvailable !== available) {
            card.dataset.available = available;
            // Re-render card state
            this.#renderCardStates();
          }
        });
      } catch { /* silently skip */ }

      // Small yield to not block main thread
      await new Promise(r => setTimeout(r, 80));
    }
  }

  /* ── Countdown timer ─────────────────────────────────────────────── */
  #initTimer() {
    const timerBar = this.closest('.bundle-builder-section')?.querySelector('.bb-timer-bar');
    if (!timerBar) return;

    const endStr = timerBar.dataset.end;
    if (!endStr) return;

    const endDate = new Date(endStr).getTime();
    if (isNaN(endDate)) return;

    const update = () => {
      const diff = endDate - Date.now();
      if (diff <= 0) {
        timerBar.hidden = true;
        clearInterval(this.#timerInterval);
        return;
      }
      const days    = Math.floor(diff / 86400000);
      const hours   = Math.floor((diff % 86400000) / 3600000);
      const minutes = Math.floor((diff % 3600000) / 60000);
      const seconds = Math.floor((diff % 60000) / 1000);

      timerBar.querySelector('[data-unit="days"]').textContent    = String(days).padStart(2, '0');
      timerBar.querySelector('[data-unit="hours"]').textContent   = String(hours).padStart(2, '0');
      timerBar.querySelector('[data-unit="minutes"]').textContent = String(minutes).padStart(2, '0');
      timerBar.querySelector('[data-unit="seconds"]').textContent = String(seconds).padStart(2, '0');
    };

    update();
    this.#timerInterval = setInterval(update, 1000);
  }

  /* ── Search / filter ─────────────────────────────────────────────── */
  #initSearch() {
    const input = this.querySelector('.bb-search-input');
    if (!input) return;

    input.addEventListener('input', () => {
      clearTimeout(this.#searchDebounce);
      this.#searchDebounce = setTimeout(() => this.#filterCards(input.value), 200);
    });
  }

  #filterCards(query) {
    const q = query.trim().toLowerCase();
    this.querySelectorAll('.bb-product-card').forEach(card => {
      if (!q) { card.hidden = false; return; }
      const title  = (card.dataset.title || '').toLowerCase();
      const vendor = (card.querySelector('.bb-product-card__vendor')?.textContent || '').toLowerCase();
      card.hidden = !title.includes(q) && !vendor.includes(q);
    });
  }

  /* ── Hint / status messages ──────────────────────────────────────── */
  #showHint(msg, type = '') {
    const hint = this.querySelector('.bb-cta-hint');
    if (!hint) return;
    hint.textContent = msg;
    hint.className = 'bb-cta-hint' + (type ? ` is-${type}` : '');

    if (type !== 'error') {
      setTimeout(() => {
        hint.textContent = '';
        hint.className = 'bb-cta-hint';
      }, 4000);
    }
  }

  /* ── Screen reader announcer ─────────────────────────────────────── */
  #srAnnounce(msg) {
    const el = document.getElementById(`bb-sr-status-${this.#sectionId}`);
    if (!el) return;
    el.textContent = '';
    requestAnimationFrame(() => { el.textContent = msg; });
  }

  #announceReady() {
    this.#srAnnounce(this.#t('builder_ready', 'Bundle builder ready. Select products to build your bundle.'));
  }

  /* ── Analytics / dataLayer ───────────────────────────────────────── */
  #track(event, data = {}) {
    try {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ event, bundle_section: this.#sectionId, ...data });
    } catch { /* silently ignore */ }
  }

  /* ── Utilities ───────────────────────────────────────────────────── */
  #formatMoney(cents) {
    const amount = (cents / 100).toFixed(3);
    if (this.#currency === 'KWD') return `${amount} KD`;
    return new Intl.NumberFormat(this.#locale, { style: 'currency', currency: this.#currency }).format(cents / 100);
  }

  #escHtml(str) {
    return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  // Arabic strings for dynamic (JS-generated) messages. When the storefront
  // locale is Arabic (dir=rtl) these override the English fallbacks below.
  #i18nAr = {
    add: 'أضف',
    add_more: 'أضف',
    added_to_bundle: 'أُضيف إلى الطقم',
    added_to_cart: 'تمت إضافة الطقم إلى السلة!',
    builder_ready: 'أداة بناء الطقم جاهزة. اختر المنتجات لبناء طقمك.',
    bundle_complete: 'اكتمل الطقم! جاهز للإضافة إلى السلة.',
    bundle_full: 'اكتمل الطقم!',
    cart_error: 'حدث خطأ ما. يرجى المحاولة مرة أخرى.',
    complete_step: 'أكمل هذه الخطوة أولاً.',
    decrease_qty: 'تقليل الكمية',
    empty_state: 'طقمك فارغ. ابدأ بإضافة المنتجات!',
    free: 'مجاناً',
    free_gift_unlocked: 'تم فتح الهدية المجانية!',
    increase_qty: 'زيادة الكمية',
    of: 'من',
    off: 'خصم',
    quantity: 'الكمية',
    quick_view_error: 'تعذّر تحميل تفاصيل المنتج.',
    removed_from_bundle: 'أُزيل من الطقم',
    required_item: 'لا يمكن إزالة عنصر إلزامي.',
    step: 'خطوة',
    view_full: 'عرض المنتج كامل',
  };

  #t(key, fallback) {
    // Locale-aware: return the Arabic string in RTL locales, else the English
    // fallback. Composed/interpolated messages are localised at the call site.
    if (this.#dir === 'rtl' && this.#i18nAr[key] != null) {
      return this.#i18nAr[key];
    }
    return fallback;
  }
}

/* ── Register custom element (deferred, non-blocking) ─────────────── */
if ('customElements' in window) {
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => customElements.define('bundle-builder', BundleBuilder));
  } else {
    customElements.define('bundle-builder', BundleBuilder);
  }
}

})();
</script>

