{%- comment -%}
  ═══════════════════════════════════════════════════════════════════════════
  BUNDLE BUILDER — "Build Your Own Bundle" (OUAI-inspired)
  Al Moallem Mill · Kuwait · KWD · Arabic (RTL) + English (LTR)

  Design language mirrors theouai.com/pages/build-your-own-bundle:
    · light warm-grey canvas, huge bold uppercase section headings
    · long-scroll category sections (one heading + product grid each)
    · image-forward product cards with a black circular "+" add button
    · a sticky vertical "bundle rail" of circular slots on the right
      (filled = product thumb in a dashed ring + trash button, empty = white)
    · the rail collapses to a horizontal pill on mobile
    · "save X% + free mini at N items" reward messaging
  ═══════════════════════════════════════════════════════════════════════════
{%- endcomment -%}

{%- liquid
  assign bb = section.settings
  assign sid = section.id

  assign locale_dir = 'ltr'
  assign locale_is_ar = false
  if request.locale.iso_code == 'ar'
    assign locale_dir = 'rtl'
    assign locale_is_ar = true
  endif

  assign min_qty = bb.min_products | default: 3
  assign max_qty = bb.max_products | default: 6

  assign heading = bb.title
  assign subheading = bb.subtitle
  if locale_is_ar and bb.title_ar != blank
    assign heading = bb.title_ar
  endif
  if locale_is_ar and bb.subtitle_ar != blank
    assign subheading = bb.subtitle_ar
  endif

  assign img_fit = bb.image_fit | default: 'contain'
  assign img_pad = 0
  if img_fit == 'contain'
    assign img_pad = 10
  endif
-%}

{%- comment -%} ── Tiers JSON (tier_discount blocks override section settings) ── {%- endcomment -%}
{%- assign has_tier_blocks = false -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'tier_discount' and block.settings.min_qty > 0 -%}
    {%- assign has_tier_blocks = true -%}
  {%- endif -%}
{%- endfor -%}

{%- capture tiers_json -%}
[
{%- assign first = true -%}
{%- if has_tier_blocks -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'tier_discount' and block.settings.min_qty > 0 -%}
      {%- unless first %},{% endunless -%}{%- assign first = false -%}
      {%- assign tlabel = block.settings.label -%}
      {%- if locale_is_ar and block.settings.label_ar != blank -%}{%- assign tlabel = block.settings.label_ar -%}{%- endif -%}
      {"qty":{{ block.settings.min_qty }},"discount":{{ block.settings.discount | default: 0 }},"label":{{ tlabel | default: '' | json }}}
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  {%- if bb.tier_1_qty > 0 -%}{%- unless first %},{% endunless -%}{%- assign first = false -%}{"qty":{{ bb.tier_1_qty }},"discount":{{ bb.tier_1_discount | default: 0 }},"label":{{ bb.tier_1_label | default: '' | json }}}{%- endif -%}
  {%- if bb.tier_2_qty > 0 -%}{%- unless first %},{% endunless -%}{%- assign first = false -%}{"qty":{{ bb.tier_2_qty }},"discount":{{ bb.tier_2_discount | default: 0 }},"label":{{ bb.tier_2_label | default: '' | json }}}{%- endif -%}
  {%- if bb.tier_3_qty > 0 -%}{%- unless first %},{% endunless -%}{%- assign first = false -%}{"qty":{{ bb.tier_3_qty }},"discount":{{ bb.tier_3_discount | default: 0 }},"label":{{ bb.tier_3_label | default: '' | json }}}{%- endif -%}
{%- endif -%}
]
{%- endcapture -%}

{%- comment -%} ── Free gift JSON ── {%- endcomment -%}
{%- if bb.enable_free_gift and bb.free_gift_product != blank -%}
  {%- assign fg = bb.free_gift_product -%}
  {%- capture free_gift_json -%}{"id":{{ fg.variants.first.id }},"title":{{ fg.title | json }},"image":{{ fg.featured_image | image_url: width: 160 | json }},"threshold":{{ bb.free_gift_threshold | default: 3 }}}{%- endcapture -%}
{%- else -%}
  {%- assign free_gift_json = 'null' -%}
{%- endif -%}

{%- assign marquee = bb.marquee_text -%}
{%- if locale_is_ar and bb.marquee_text_ar != blank -%}{%- assign marquee = bb.marquee_text_ar -%}{%- endif -%}

<section
  id="bundle-builder-{{ sid }}"
  class="byob"
  dir="{{ locale_dir }}"
  data-section-id="{{ sid }}"
  style="--byob-pt:{{ bb.section_padding_top | default: 24 }}px;--byob-pb:{{ bb.section_padding_bottom | default: 64 }}px;--byob-img-fit:{{ img_fit }};--byob-img-pad:{{ img_pad }}%;"
  aria-label="{%- if locale_is_ar -%}أنشئ طقمك{%- else -%}Build your own bundle{%- endif -%}"
>

  {%- comment -%} ── Scrolling marquee (optional) ── {%- endcomment -%}
  {%- if marquee != blank -%}
  <div class="byob-marquee" aria-hidden="true">
    <div class="byob-marquee__track">
      {%- for i in (1..6) -%}<span class="byob-marquee__item">{{ marquee }}</span>{%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  <bundle-builder
    class="byob-app"
    data-section-id="{{ sid }}"
    data-min="{{ min_qty }}"
    data-max="{{ max_qty }}"
    data-currency="{{ shop.currency }}"
    data-locale="{{ request.locale.iso_code }}"
    data-dir="{{ locale_dir }}"
    data-tiers="{{ tiers_json | escape }}"
    data-free-gift="{{ free_gift_json | escape }}"
    data-redirect="{{ bb.redirect_to_cart | default: false }}"
  >

    {%- comment -%} ── Hero ── {%- endcomment -%}
    <header class="byob-hero">
      {%- if heading != blank -%}
        <h1 class="byob-hero__title">{{ heading }}</h1>
      {%- endif -%}
      {%- if subheading != blank -%}
        <p class="byob-hero__sub">{{ subheading }}</p>
      {%- endif -%}
      <p class="byob-hero__reward" data-reward>
        {%- if locale_is_ar -%}
          ابدأ بإضافة المنتجات لبناء طقمك.
        {%- else -%}
          Start adding products to build your bundle.
        {%- endif -%}
      </p>
    </header>

    {%- comment -%} ── Value props row ── {%- endcomment -%}
    {%- if bb.show_value_props -%}
      {%- assign vp1 = bb.vp_1 -%}{%- assign vp2 = bb.vp_2 -%}{%- assign vp3 = bb.vp_3 -%}
      {%- if locale_is_ar -%}
        {%- if bb.vp_1_ar != blank -%}{%- assign vp1 = bb.vp_1_ar -%}{%- endif -%}
        {%- if bb.vp_2_ar != blank -%}{%- assign vp2 = bb.vp_2_ar -%}{%- endif -%}
        {%- if bb.vp_3_ar != blank -%}{%- assign vp3 = bb.vp_3_ar -%}{%- endif -%}
      {%- endif -%}
      {%- if vp1 != blank or vp2 != blank or vp3 != blank -%}
      <ul class="byob-vprops">
        {%- if vp1 != blank -%}<li class="byob-vprops__item">{{ vp1 }}</li>{%- endif -%}
        {%- if vp2 != blank -%}<li class="byob-vprops__item">{{ vp2 }}</li>{%- endif -%}
        {%- if vp3 != blank -%}<li class="byob-vprops__item">{{ vp3 }}</li>{%- endif -%}
      </ul>
      {%- endif -%}
    {%- endif -%}

    <div class="byob-grid-wrap">

      {%- comment -%} ── Main scroll column ── {%- endcomment -%}
      <div class="byob-main">
        {%- assign panel_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection' -%}
            {%- assign panel_index = panel_index | plus: 1 -%}
            {%- assign blk = block.settings -%}
            {%- assign col = blk.collection -%}
            {%- assign p_limit = blk.product_limit | default: 24 -%}

            {%- assign cat_title = blk.collection_tab_label | default: col.title | default: 'Products' -%}

            <section class="byob-cat" data-panel="{{ panel_index }}" {{ block.shopify_attributes }}>
              <h2 class="byob-cat__title">{{ cat_title }}</h2>
              {%- if blk.step_description != blank -%}
                <p class="byob-cat__desc">{{ blk.step_description }}</p>
              {%- endif -%}

              <div class="byob-cards">
                {%- assign shown = 0 -%}
                {%- for product in col.products limit: p_limit -%}
                  {%- assign v = product.variants.first -%}
                  {%- assign multi = false -%}
                  {%- if product.variants.size > 1 -%}{%- assign multi = true -%}{%- endif -%}
                  {%- assign desc = product.description | strip_html | truncatewords: 26 -%}

                  <article
                    class="byob-card"
                    data-product-id="{{ product.id }}"
                    data-variant-id="{{ v.id }}"
                    data-title="{{ product.title | escape }}"
                    data-price="{{ v.price }}"
                    data-handle="{{ product.handle }}"
                    data-available="{{ v.available }}"
                    data-panel="{{ panel_index }}"
                  >
                    <div class="byob-card__media">
                      {%- if product.featured_image -%}
                        <img
                          class="byob-card__img"
                          src="{{ product.featured_image | image_url: width: 600 }}"
                          alt="{{ product.featured_image.alt | default: product.title | escape }}"
                          width="600" height="600" loading="lazy"
                        >
                      {%- else -%}
                        <div class="byob-card__noimg" aria-hidden="true">{{ shop.name | slice: 0, 1 | upcase }}</div>
                      {%- endif -%}

                      {%- unless v.available -%}
                        <span class="byob-card__soldout">{%- if locale_is_ar -%}نفدت الكمية{%- else -%}Sold out{%- endif -%}</span>
                      {%- endunless -%}

                      <button
                        class="byob-card__add"
                        type="button"
                        data-action="add"
                        data-variant-id="{{ v.id }}"
                        data-product-id="{{ product.id }}"
                        aria-label="{%- if locale_is_ar -%}أضف إلى الطقم{%- else -%}Add to bundle{%- endif -%}: {{ product.title | escape }}"
                        {% unless v.available %}disabled aria-disabled="true"{% endunless %}
                      >
                        <svg class="byob-card__add-plus" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        <span class="byob-card__add-count" data-count hidden>0</span>
                      </button>
                    </div>

                    <div class="byob-card__body">
                      <h3 class="byob-card__title">{{ product.title }}</h3>
                      <p class="byob-card__price">{{ v.price | money }}</p>

                      {%- if multi -%}
                      <select class="byob-card__variant" data-variant-select aria-label="{%- if locale_is_ar -%}اختر الخيار{%- else -%}Select option{%- endif -%}">
                        {%- for variant in product.variants -%}
                          <option value="{{ variant.id }}" data-price="{{ variant.price }}" data-available="{{ variant.available }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money }}</option>
                        {%- endfor -%}
                      </select>
                      {%- endif -%}

                      {%- if desc != blank -%}
                        <p class="byob-card__desc">{{ desc }}</p>
                      {%- endif -%}
                    </div>
                  </article>
                  {%- assign shown = shown | plus: 1 -%}
                {%- endfor -%}

                {%- if shown == 0 -%}
                  <p class="byob-empty">{%- if locale_is_ar -%}لا توجد منتجات في هذا القسم بعد.{%- else -%}No products in this category yet.{%- endif -%}</p>
                {%- endif -%}
              </div>
            </section>
          {%- endif -%}
        {%- endfor -%}

        {%- if panel_index == 0 -%}
          <div class="byob-setup-hint">
            {%- if locale_is_ar -%}
              أضف كتل «قسم» من محرّر القالب واختر مجموعة لكل قسم لعرض المنتجات هنا.
            {%- else -%}
              Add “Category” blocks in the theme editor and pick a collection for each to show products here.
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ── Sticky vertical bundle rail (desktop) ── {%- endcomment -%}
      <aside class="byob-rail" aria-label="{%- if locale_is_ar -%}طقمك{%- else -%}Your bundle{%- endif -%}">
        <div class="byob-rail__inner">
          <p class="byob-rail__heading">{%- if locale_is_ar -%}طقمك{%- else -%}Your Bundle{%- endif -%}</p>

          <div class="byob-rail__track" id="byob-rail-{{ sid }}" aria-live="polite">
            {%- for i in (1..max_qty) -%}
              <div class="byob-slot" data-slot="{{ i }}">
                <span class="byob-slot__ring">
                  <span class="byob-slot__empty"></span>
                </span>
                {%- if forloop.last == false -%}<span class="byob-slot__link" aria-hidden="true"></span>{%- endif -%}
              </div>
            {%- endfor -%}
          </div>

          <div class="byob-rail__foot">
            <div class="byob-reward-bar" aria-hidden="true">
              <div class="byob-reward-bar__fill" data-reward-fill></div>
            </div>
            <p class="byob-rail__msg" data-rail-msg aria-live="polite"></p>

            <div class="byob-totals">
              <div class="byob-totals__row byob-totals__row--strike" data-orig-row hidden>
                <span>{%- if locale_is_ar -%}الأصلي{%- else -%}Original{%- endif -%}</span>
                <s data-orig></s>
              </div>
              <div class="byob-totals__row byob-totals__row--save" data-save-row hidden>
                <span>{%- if locale_is_ar -%}وفّرت{%- else -%}You save{%- endif -%}</span>
                <span data-save></span>
              </div>
              <div class="byob-totals__row byob-totals__row--total">
                <span>{%- if locale_is_ar -%}الإجمالي{%- else -%}Total{%- endif -%}</span>
                <strong data-total>{{ 0 | money }}</strong>
              </div>
            </div>

            <button class="byob-cta" type="button" data-action="checkout" disabled aria-disabled="true">
              <span class="byob-cta__label">{%- if locale_is_ar -%}أضف الطقم إلى السلة{%- else -%}Add Bundle to Cart{%- endif -%}</span>
              <span class="byob-cta__spin" hidden aria-hidden="true"></span>
            </button>
            <p class="byob-cta__hint" data-hint aria-live="assertive"></p>
          </div>
        </div>
      </aside>
    </div>

    {%- comment -%} ── How it works ── {%- endcomment -%}
    {%- if bb.show_how -%}
      {%- assign how_title = bb.how_title -%}
      {%- if locale_is_ar and bb.how_title_ar != blank -%}{%- assign how_title = bb.how_title_ar -%}{%- endif -%}
      <section class="byob-how" aria-label="{{ how_title | escape }}">
        {%- if how_title != blank -%}<h2 class="byob-how__title">{{ how_title }}</h2>{%- endif -%}
        <ol class="byob-how__steps">
          {%- for n in (1..3) -%}
            {%- assign st = bb['how_' | append: n | append: '_title'] -%}
            {%- assign sx = bb['how_' | append: n | append: '_text'] -%}
            {%- if locale_is_ar -%}
              {%- assign st_ar = bb['how_' | append: n | append: '_title_ar'] -%}
              {%- assign sx_ar = bb['how_' | append: n | append: '_text_ar'] -%}
              {%- if st_ar != blank -%}{%- assign st = st_ar -%}{%- endif -%}
              {%- if sx_ar != blank -%}{%- assign sx = sx_ar -%}{%- endif -%}
            {%- endif -%}
            {%- if st != blank or sx != blank -%}
              <li class="byob-how__step">
                <span class="byob-how__num" aria-hidden="true">{{ n }}</span>
                {%- if st != blank -%}<h3 class="byob-how__step-title">{{ st }}</h3>{%- endif -%}
                {%- if sx != blank -%}<p class="byob-how__step-text">{{ sx }}</p>{%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      </section>
    {%- endif -%}

    {%- comment -%} ── FAQ (native accordion, zero-JS) ── {%- endcomment -%}
    {%- assign faq_count = 0 -%}
    {%- for block in section.blocks -%}{%- if block.type == 'faq' -%}{%- assign faq_count = faq_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if faq_count > 0 -%}
      {%- assign faq_heading = bb.faq_heading -%}
      {%- if locale_is_ar and bb.faq_heading_ar != blank -%}{%- assign faq_heading = bb.faq_heading_ar -%}{%- endif -%}
      <section class="byob-faq" aria-label="{{ faq_heading | default: 'FAQ' | escape }}">
        {%- if faq_heading != blank -%}<h2 class="byob-faq__title">{{ faq_heading }}</h2>{%- endif -%}
        <div class="byob-faq__list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'faq' -%}
              {%- assign q = block.settings.question -%}
              {%- assign a = block.settings.answer -%}
              {%- if locale_is_ar -%}
                {%- if block.settings.question_ar != blank -%}{%- assign q = block.settings.question_ar -%}{%- endif -%}
                {%- if block.settings.answer_ar != blank -%}{%- assign a = block.settings.answer_ar -%}{%- endif -%}
              {%- endif -%}
              {%- if q != blank -%}
                <details class="byob-faq__item" {{ block.shopify_attributes }}>
                  <summary class="byob-faq__q">
                    <span>{{ q }}</span>
                    <span class="byob-faq__chev" aria-hidden="true">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
                    </span>
                  </summary>
                  <div class="byob-faq__a">{{ a }}</div>
                </details>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}

    {%- comment -%} ── Mobile bottom bar ── {%- endcomment -%}
    <div class="byob-mobilebar" id="byob-mobilebar-{{ sid }}">
      <div class="byob-mobilebar__top">
        <div class="byob-mobilebar__slots" data-mobile-slots aria-hidden="true"></div>
        <strong class="byob-mobilebar__total" data-total>{{ 0 | money }}</strong>
      </div>
      <p class="byob-mobilebar__msg" data-rail-msg></p>
      <button class="byob-cta byob-cta--mobile" type="button" data-action="checkout" disabled aria-disabled="true">
        <span class="byob-cta__label">{%- if locale_is_ar -%}أضف الطقم إلى السلة{%- else -%}Add Bundle to Cart{%- endif -%}</span>
        <span class="byob-cta__spin" hidden aria-hidden="true"></span>
      </button>
    </div>

    {%- comment -%} ── Free-mini reward toast (optional) ── {%- endcomment -%}
    {%- if free_gift_json != 'null' -%}
    <div class="byob-gift" data-gift hidden role="status">
      <span class="byob-gift__icon" aria-hidden="true">🎁</span>
      <span class="byob-gift__text">
        {%- if locale_is_ar -%}فتحت هديتك المجانية!{%- else -%}You unlocked your free mini!{%- endif -%}
      </span>
    </div>
    {%- endif -%}

    <span class="byob-sr" data-sr aria-live="polite"></span>
  </bundle-builder>
</section>

<style>
/* ═══════════════════════════════════════════════════════════════════════════
   BYOB — OUAI-inspired bundle builder. CSS logical properties throughout for
   automatic LTR/RTL parity.
   ═══════════════════════════════════════════════════════════════════════════ */
.byob {
  --byob-bg:        {{ section.settings.color_bg        | default: '#f1f0ec' }};
  --byob-ink:       {{ section.settings.color_text      | default: '#141414' }};
  --byob-muted:     {{ section.settings.color_muted     | default: '#6f6c66' }};
  --byob-card:      {{ section.settings.color_card_bg   | default: '#ffffff' }};
  --byob-media-bg:  #eceae4;
  --byob-rail-bg:   {{ section.settings.color_rail_bg   | default: '#e7dbd1' }};
  --byob-accent:    {{ section.settings.color_accent    | default: '#141414' }};
  --byob-success:   #2f8f5b;
  --byob-line:      #d9d4cc;
  --byob-radius:    {{ section.settings.card_radius     | default: 14 }}px;

  background: var(--byob-bg);
  color: var(--byob-ink);
  padding-block: var(--byob-pt) var(--byob-pb);
  container-type: inline-size;
  font-synthesis: none;
}

.byob *,
.byob *::before,
.byob *::after { box-sizing: border-box; }

.byob-sr {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
}

/* ── Marquee ───────────────────────────────────────────────────────────── */
.byob-marquee {
  overflow: hidden;
  border-block: 1px solid var(--byob-line);
  background: color-mix(in srgb, var(--byob-rail-bg) 35%, var(--byob-bg));
  margin-block-end: clamp(1.5rem, 5cqi, 3rem);
}
.byob-marquee__track {
  display: flex; gap: 3rem; width: max-content;
  padding-block: 0.6rem;
  animation: byob-marquee 28s linear infinite;
}
.byob-marquee__item {
  font-size: 0.8rem; font-weight: 700; letter-spacing: 0.14em;
  text-transform: uppercase; white-space: nowrap; color: var(--byob-ink);
}
@keyframes byob-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
[dir="rtl"] .byob-marquee__track { animation-direction: reverse; }
@media (prefers-reduced-motion: reduce) { .byob-marquee__track { animation: none; } }

/* ── Hero ──────────────────────────────────────────────────────────────── */
.byob-hero {
  max-width: 880px;
  margin-inline: auto;
  padding-inline: 1.25rem;
  text-align: center;
  margin-block-end: clamp(2rem, 6cqi, 4rem);
}
.byob-hero__title {
  font-size: clamp(2.4rem, 9cqi, 5.5rem);
  font-weight: 800;
  line-height: 0.95;
  letter-spacing: 0.01em;
  text-transform: uppercase;
  margin: 0 0 1rem;
  color: var(--byob-ink);
}
.byob-hero__sub {
  font-size: clamp(1.05rem, 2.4cqi, 1.5rem);
  line-height: 1.4;
  margin: 0 auto;
  max-width: 46ch;
  color: var(--byob-ink);
}
.byob-hero__reward {
  margin: 1rem 0 0;
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--byob-muted);
}

/* ── Value props row ───────────────────────────────────────────────────── */
.byob-vprops {
  list-style: none;
  margin: 0 auto clamp(2rem, 6cqi, 4rem);
  padding: 0 1.25rem;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.75rem 2.5rem;
  max-width: 1000px;
}
.byob-vprops__item {
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--byob-ink);
}

/* ── Layout: main + rail ───────────────────────────────────────────────── */
.byob-grid-wrap {
  display: grid;
  grid-template-columns: 1fr 300px;
